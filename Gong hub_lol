-- ============================================================
-- EXECUTOR SHIMS (delta-safe, no nil calls)
-- ============================================================
local function safeTaskSpawn(fn, ...)
    if type(task) == "table" and type(task.spawn) == "function" then
        return task.spawn(fn, ...)
    elseif type(spawn) == "function" then
        return spawn(fn, ...)
    else
        return coroutine.wrap(function() fn(...) end)()
    end
end
local function safeWait(n)
    if type(task) == "table" and type(task.wait) == "function" then return task.wait(n) end
    if type(wait) == "function" then return wait(n) end
    return 0
end
local function safeDelay(n, fn)
    if type(task) == "table" and type(task.delay) == "function" then return task.delay(n, fn) end
    if type(delay) == "function" then return delay(n, fn) end
end

local function doRequest(opts)
    local candidates = {
        rawget(getfenv(), "request"),
        rawget(getfenv(), "http_request"),
        type(syn) == "table" and syn.request or nil,
        type(fluxus) == "table" and fluxus.request or nil,
        type(http) == "table" and http.request or nil,
    }
    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            local ok, res = pcall(fn, opts)
            if ok and type(res) == "table" then return res end
        end
    end
    return nil
end

local function httpGet(url)
    local res = doRequest({ Url = url, Method = "GET" })
    if res and res.Body then return res.Body end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" then return body end
    return nil
end

-- Font.new fallback -> plain Enum.Font.Code
local FONT
do
    local ok, f = pcall(function()
        return Font.new("rbxasset://fonts/families/Inconsolata.json",
            Enum.FontWeight.Regular, Enum.FontStyle.Normal)
    end)
    if ok and f then
        FONT = f
    else
        FONT = Enum.Font.Code
    end
end

-- ============================================================
-- FILE SHIMS
-- ============================================================
local function fsWrite(path, data)
    local w = rawget(getfenv(), "writefile")
    if type(w) == "function" then pcall(w, path, data) end
end
local function fsRead(path)
    local r = rawget(getfenv(), "readfile")
    if type(r) == "function" then
        local ok, v = pcall(r, path)
        if ok then return v end
    end
    return nil
end

