--========================================================
-- TP TARGET SELECTOR (respects blacklist)
--========================================================

local selectedPlayer = nil

local function pickNextPlayer()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and not isBlacklisted(p) then
            table.insert(list, p)
        end
    end
    if #list == 0 then selectedPlayer = nil return end
    local idx = 1
    for i, p in ipairs(list) do
        if p == selectedPlayer then idx = i break end
    end
    idx = idx % #list + 1
    selectedPlayer = list[idx]
end

local function tpPlayer()
    if not selectedPlayer then return end
    local thrp = selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    local char = lp.Character
    if not char or not thrp then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then pcall(function() hrp.CFrame = thrp.CFrame + Vector3.new(0, 3, 0) end) end
end

