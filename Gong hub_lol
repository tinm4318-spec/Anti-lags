        rm.Size = UDim2.new(0, 26, 0, 16)
        rm.Position = UDim2.new(0, 308, 0, 2)
        rm.BackgroundColor3 = C.bad
        rm.BorderColor3 = C.border
        rm.BorderSizePixel = 1
        rm.FontFace = FONT
        rm.TextSize = 12
        rm.TextColor3 = C.text
        rm.Text = "X"
        rm.MouseButton1Click:Connect(function()
            removeFromBlacklist(key)
            rebuildBlacklistUI()
        end)
    end
end

