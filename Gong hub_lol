local function findDeleteTools()
    local dtools = {}
    local function scan(container)
        if not container then return end
        for _, v in ipairs(container:GetChildren()) do
            if v:IsA("Tool") and v.Name == "Delete" then
                local s = v:FindFirstChild("Script")
                local e = s and s:FindFirstChild("Event")
                if e then table.insert(dtools, { bt = v, e = e }) end
            end
        end
    end
    scan(LocalPlayer:FindFirstChild("Backpack"))
    if LocalPlayer.Character then scan(LocalPlayer.Character) end
    return dtools
end

local function getAllBricks()
    local bricks = {}
    local folder = workspace:FindFirstChild("Bricks")
    if not folder then return bricks end
    for _, brick in ipairs(folder:GetDescendants()) do
        if brick:IsA("BasePart") and brick.Name == "Brick" then
            table.insert(bricks, brick)
        end
    end
    return bricks
end

local function refreshToolStatus()
    local tools = findDeleteTools()
    if #tools == 0 then
        toolStatus.Text = "delete tool: none found (need at least 1)"
        toolStatus.TextColor3 = C.danger
        startBtn.BackgroundColor3 = C.panelAlt
        startBtn.TextColor3 = C.textDim
        return false
    end
    toolStatus.Text = string.format("delete tool: %d found", #tools)
    toolStatus.TextColor3 = C.good
    startBtn.BackgroundColor3 = C.accent
    startBtn.TextColor3 = C.bg
    return true
end

local function clearHighlights()
    for _, h in ipairs(highlights) do
        if h and h.Parent then pcall(function() h:Destroy() end) end
    end
    highlights = {}
end

local function applyHighlights()
    clearHighlights()
    local bricks = getAllBricks()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp and #bricks > 0 then
        table.sort(bricks, function(a, b)
            return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
        end)
    end
    local limit = math.min(#bricks, 80)
    for i = 1, limit do
        local brick = bricks[i]
        if brick and brick.Parent then
            local h = Instance.new("Highlight")
            h.Adornee = brick
            h.FillColor = Color3.fromRGB(255, 0, 0)
            h.OutlineColor = Color3.fromRGB(255, 0, 0)
            h.FillTransparency = 0.5
            h.OutlineTransparency = 1
            h.Parent = brick
            table.insert(highlights, h)
        end
    end
end

