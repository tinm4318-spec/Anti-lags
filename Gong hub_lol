-- Noclip Bypass (TCO-grade: floor snap + wall push via raycasts)
local noclipBypassConn
local function setNoclipBypass(on)
    if noclipBypassConn then noclipBypassConn:Disconnect() noclipBypassConn = nil end
    if not on then return end
    local HALF_H, HALF_W, EXTRA, SCAN = 2.1, 0.6, 0.05, 8
    noclipBypassConn = addConn(RunService.RenderStepped:Connect(function()
        local char = lp.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local pos = hrp.Position
        local cf = hrp.CFrame

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {char}

        -- floor snap
        local floorHit = workspace:Raycast(pos, Vector3.new(0, -SCAN, 0), rp)
        if floorHit then
            local surfaceY = floorHit.Position.Y + HALF_H
            if pos.Y < surfaceY then
                local vel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                hrp.CFrame = CFrame.new(Vector3.new(pos.X, surfaceY, pos.Z))
                    * CFrame.fromMatrix(Vector3.new(), cf.RightVector, cf.UpVector)
                pos = hrp.Position
            end
        end

        -- wall push
        local newPos = pos
        local scanDist = HALF_W + 1
        for _, dir in ipairs({cf.LookVector, -cf.LookVector, cf.RightVector, -cf.RightVector}) do
            local res = workspace:Raycast(pos, dir * scanDist, rp)
            if res then
                local dist = (res.Position - pos).Magnitude
                if dist < HALF_W then
                    newPos = newPos + (-dir * (HALF_W - dist + EXTRA))
                end
            end
        end
        if (newPos - pos).Magnitude > 0.01 then
            local cur = hrp.CFrame
            hrp.CFrame = CFrame.new(newPos) * CFrame.fromMatrix(Vector3.new(), cur.RightVector, cur.UpVector)
        end
    end))
end

