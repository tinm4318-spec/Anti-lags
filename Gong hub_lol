local Protections = {}
local function addProt(name, label, startFn, stopFn)
    Protections[name] = { label = label, start = startFn, stop = stopFn, active = false, conns = {} }
end
local function setProt(name, on)
    local p = Protections[name]; if not p or on == p.active then return end
    p.active = on
    if on then pcall(p.start) else
        pcall(p.stop)
        for _, c in ipairs(p.conns) do pcall(function() c:Disconnect() end) end
        p.conns = {}
    end
end

