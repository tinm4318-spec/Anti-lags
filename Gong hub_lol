--========================================================
-- WALL WALK (camera + transparency trick, resets on respawn)
--========================================================

local function setWallWalk(on)
    if Wall.conn then Wall.conn:Disconnect(); Wall.conn = nil end
    if not on then
        if Wall.savedMin then lp.CameraMinZoomDistance = Wall.savedMin end
        if Wall.savedMax then lp.CameraMaxZoomDistance = Wall.savedMax end
        Wall.savedMin = nil; Wall.savedMax = nil
        Wall.on = false
        return
    end
    Wall.savedMin = lp.CameraMinZoomDistance
    Wall.savedMax = lp.CameraMaxZoomDistance
    Wall.on = true
    Wall.conn = addConn(RunService.RenderStepped:Connect(function()
        if not Wall.on then return end
        if lp.CameraMinZoomDistance ~= 0.5 then lp.CameraMinZoomDistance = 0.5 end
        if lp.CameraMaxZoomDistance ~= 128 then lp.CameraMaxZoomDistance = 128 end
        local char = lp.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.LocalTransparencyModifier ~= 0 then
                    p.LocalTransparencyModifier = 0
                end
            end
        end
    end))
    addConn(lp.CharacterAdded:Connect(function()
        if Wall.conn then Wall.conn:Disconnect(); Wall.conn = nil end
        Wall.on = false
        if Wall.savedMin then lp.CameraMinZoomDistance = Wall.savedMin end
        if Wall.savedMax then lp.CameraMaxZoomDistance = Wall.savedMax end
    end))
end

