local function setSpin(on)
    if Spin.conn then Spin.conn:Disconnect(); Spin.conn = nil end
    Spin.on = on
    if not on then return end
    local angle = 0
    Spin.conn = addConn(RunService.RenderStepped:Connect(function(dt)
        local char = lp.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        angle = angle + (-Spin.value * 3 * dt * 60)
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(angle), 0)
    end))
end

