local function rebuildBlacklistUI()
    for _, c in ipairs(blScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local keys = {}
    for k in pairs(Blacklist.list) do table.insert(keys, k) end
    table.sort(keys)
    if #keys == 0 then
        local e = Instance.new("TextLabel", blScroll)
        e.Size = UDim2.new(0, 339, 0, 40)
        e.BackgroundTransparency = 1
        e.FontFace = FONT
        e.TextSize = 11
        e.TextColor3 = C.muted
        e.Text = "blacklist empty"
        e.LayoutOrder = 1
        return
    end
    for i, key in ipairs(keys) do
        local row = Instance.new("Frame", blScroll)
        row.Size = UDim2.new(0, 339, 0, 20)
        row.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
        row.BorderColor3 = C.border
        row.BorderSizePixel = 1
        row.LayoutOrder = i

        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(0, 300, 0, 20)
        lbl.Position = UDim2.new(0, 4, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.FontFace = FONT
        lbl.TextSize = 11
        lbl.TextColor3 = C.text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Text = key

        local rm = Instance.new("TextButton", row)
        rm.Size = UDim2.new(0, 26, 0, 16)
        rm.Position = UDim2.new(0, 308, 0, 2)
        rm.BackgroundColor3 = C.bad
        rm.BorderColor3 = C.border
        rm.BorderSizePixel = 1
        rm.FontFace = FONT
        rm.TextSize = 12
        rm.TextColor3 = C.text
        rm.Text = "X"
        rm.MouseButton1Click:Connect(function()
            removeFromBlacklist(key)
            rebuildBlacklistUI()
        end)
    end
end

blAddBtn.MouseButton1Click:Connect(function()
    if blInput.Text ~= "" then
        addToBlacklist(blInput.Text); blInput.Text = ""; rebuildBlacklistUI()
    end
end)
blInput.FocusLost:Connect(function(enter)
    if enter and blInput.Text ~= "" then
        addToBlacklist(blInput.Text); blInput.Text = ""; rebuildBlacklistUI()
    end
end)
blToggle.MouseButton1Click:Connect(function()
    Blacklist.enabled = not Blacklist.enabled
    blToggle.Text = Blacklist.enabled and "ENABLED" or "OFF"
    blToggle.BackgroundColor3 = Blacklist.enabled and C.good or C.bad
end)

rebuildBlacklistUI()

