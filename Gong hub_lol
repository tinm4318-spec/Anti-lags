--========================================================

local function saveBlacklist()
    if not supportsFiles then return end
    local out = {}
    for k in pairs(Blacklist.list) do table.insert(out, k) end
    pcall(function() writefile("gonghub_blacklist.txt", table.concat(out, "\n")) end)
end

local function isBlacklisted(plr)
    if not Blacklist.enabled or not plr then return false end
    if Blacklist.list[tostring(plr.UserId):lower()] then return true end
    if Blacklist.list[plr.Name:lower()] then return true end
    if Blacklist.list[plr.DisplayName:lower()] then return true end
    return false
end

local function addToBlacklist(entry)
    if not entry or entry == "" then return end
    local e = entry:lower()
    Blacklist.list[e] = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == e or p.DisplayName:lower() == e then
            Blacklist.list[tostring(p.UserId):lower()] = true
        end
    end
    saveBlacklist()
end

local function removeFromBlacklist(entry)
    if not entry then return end
    Blacklist.list[entry:lower()] = nil
    saveBlacklist()
end

