addProt("anti_blind", "Anti Blind", function()
    local p = Protections["anti_blind"]
    local cache = {
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        Brightness = Lighting.Brightness,
        ExposureCompensation = Lighting.ExposureCompensation,
        GlobalShadows = Lighting.GlobalShadows,
    }
    local function strip()
        for _, o in ipairs(Lighting:GetChildren()) do
            if o:IsA("BlurEffect") or o:IsA("ColorCorrectionEffect")
                or o:IsA("SunRaysEffect") or o:IsA("BloomEffect")
                or o:IsA("DepthOfFieldEffect") then
                pcall(function() o:Destroy() end)
            end
        end
    end
    strip()
    table.insert(p.conns, RunService.Heartbeat:Connect(function()
        for k, v in pairs(cache) do
            if Lighting[k] ~= v then pcall(function() Lighting[k] = v end) end
        end
        strip()
    end))
end, function() end)

addProt("anti_grab", "Anti Grab", function()
    local p = Protections["anti_grab"]
    table.insert(p.conns, RunService.Heartbeat:Connect(function()
        local char = lp.Character; if not char then return end
        for _, o in ipairs(char:GetDescendants()) do
            if o:IsA("Weld") or o:IsA("WeldConstraint") then
                local a, b = o.Part0, o.Part1
                if a and b and not (char:IsAncestorOf(a) and char:IsAncestorOf(b)) then
                    pcall(function() o:Destroy() end)
                end
            elseif o:IsA("AlignPosition") or o:IsA("AlignOrientation") then
                local a0 = o.Attachment0
                if a0 and a0.Parent and not char:IsAncestorOf(a0.Parent) then
                    pcall(function() o:Destroy() end)
                end
            end
        end
    end))
end, function() end)

addProt("anti_teleport", "Anti Teleport", function()
    local p = Protections["anti_teleport"]
    local lastPos, lastT = nil, 0
    local TH = 100
    table.insert(p.conns, RunService.Heartbeat:Connect(function()
        if tick() < tpGraceUntil then
            local char = lp.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then lastPos = hrp.Position; lastT = tick() end
            end
            return
        end
        local char = lp.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local pos, now = hrp.Position, tick()
        if lastPos and (now - lastT) < 0.15 and (pos - lastPos).Magnitude > TH then
            pcall(function() hrp.CFrame = CFrame.new(lastPos) * hrp.CFrame.Rotation end)
        end
        lastPos, lastT = pos, now
    end))
end, function() end)

