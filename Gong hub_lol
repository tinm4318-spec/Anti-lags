local function normalizeId(raw)
    if not raw or raw == "" then return nil end
    local n = raw:match("rbxassetid://(%d+)") or raw:match("^(%d+)$")
    return n
end

local function addSoundEntry(sound)
    if not sound or not sound.SoundId or sound.SoundId == "" then return end
    local id = normalizeId(sound.SoundId)
    if not id then return end
    for _, e in ipairs(Grief.soundLog) do
        if e.id == id then return end
    end
    table.insert(Grief.soundLog, {
        id = id,
        parent = (sound.Parent and sound.Parent.Name) or "?",
        t = os.date("%H:%M:%S"),
    })
    while #Grief.soundLog > 80 do table.remove(Grief.soundLog, 1) end
    if Grief.onLogUpdate then pcall(Grief.onLogUpdate) end
end

local function startSoundWatch()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Sound") then addSoundEntry(obj) end
    end
    table.insert(Grief.soundConns, workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") then addSoundEntry(obj) end
    end))
end

local function stopSoundWatch()
    for _, c in ipairs(Grief.soundConns) do pcall(function() c:Disconnect() end) end
    Grief.soundConns = {}
end

local function replaySound(id)
    id = normalizeId(id)
    if not id then return end
    local char = lp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. id
    s.Volume = 2
    s.RollOffMaxDistance = 500
    s.RollOffMinDistance = 5
    s.Parent = hrp
    s:Play()
    s.Ended:Once(function() pcall(function() s:Destroy() end) end)
end

task.spawn(function()
    while gui.Parent do
        task.wait(Grief.spamRate)
        if Grief.spamOn and Grief.spamId ~= "" then
            replaySound(Grief.spamId)
        end
    end
end)

local function collectParts()
    Grief.orbitParts = {}
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored
            and not p:IsDescendantOf(lp.Character) then
            table.insert(Grief.orbitParts, p)
        end
    end
end

-- fling: drop huge unowned part on target, with simradius boost so we own it
local function dropFling(plr)
    if not plr or not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local p = Instance.new("Part")
    p.Size = Vector3.new(30, 30, 30)
    p.Position = hrp.Position + Vector3.new(0, 25, 0)
    p.Anchored = false
    p.CanCollide = false
    p.Transparency = 1
    p.Parent = workspace
    pcall(function() p:SetNetworkOwner(lp) end)
    pcall(function() p.AssemblyLinearVelocity = Vector3.new(0, -2000, 0) end)
    task.delay(2, function() pcall(function() p:Destroy() end) end)
end

local flingConn
local function setFling(on)
    if flingConn then flingConn:Disconnect() flingConn = nil end
    if not on then return end
    flingConn = addConn(RunService.Heartbeat:Connect(function()
        if not Grief.flingOn or not selectedPlayer then return end
        pcall(function() dropFling(selectedPlayer) end)
    end))
end

-- orbit: velocity-write local unanchored parts to circle target
addConn(RunService.Heartbeat:Connect(function()
    if not Grief.orbitOn then return end
    if not selectedPlayer or not selectedPlayer.Character then return end
    local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local center = hrp.Position
    if #Grief.orbitParts == 0 or tick() % 5 < 0.02 then
        collectParts()
    end
    for _, part in ipairs(Grief.orbitParts) do
        if part.Parent and not part.Anchored then
            local pos = part.Position
            local angle = math.atan2(pos.Z - center.Z, pos.X - center.X) + 0.05
            local target = Vector3.new(
                center.X + math.cos(angle) * Grief.orbitRadius,
                center.Y,
                center.Z + math.sin(angle) * Grief.orbitRadius
            )
            pcall(function()
                part.AssemblyLinearVelocity = (target - pos).Unit * 800
            end)
        end
    end
end))

