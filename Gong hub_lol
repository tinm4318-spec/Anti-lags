-- render helper (shared)
function renderList(parentCol, tbl, fname, tag)
    local scroll = (tag == "blacklist") and blScroll or wlScroll
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local keys = {}
    for k in pairs(tbl) do table.insert(keys, k) end
    table.sort(keys)
    if #keys == 0 then
        local e = Instance.new("TextLabel", scroll)
        e.Size = UDim2.new(0, 155, 0, 18)
        e.BackgroundTransparency = 1
        e.FontFace = FONT
        e.TextSize = 10
        e.TextColor3 = C.muted
        e.Text = "(empty)"
        return
    end
    for i, key in ipairs(keys) do
        local row = Instance.new("Frame", scroll)
        row.Size = UDim2.new(0, 155, 0, 18)
        row.BackgroundColor3 = Color3.fromRGB(20, 12, 14)
        row.BorderColor3 = C.border
        row.BorderSizePixel = 1
        row.LayoutOrder = i

        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(0, 128, 0, 18)
        lbl.Position = UDim2.new(0, 3, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.FontFace = FONT
        lbl.TextSize = 10
        lbl.TextColor3 = C.text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextTruncate = Enum.TextTruncate.AtEnd
        lbl.Text = key

        local rm = Instance.new("TextButton", row)
        rm.Size = UDim2.new(0, 22, 0, 14)
        rm.Position = UDim2.new(0, 132, 0, 2)
        rm.BackgroundColor3 = C.bad
        rm.BorderColor3 = C.border
        rm.BorderSizePixel = 1
        rm.FontFace = FONT
        rm.TextSize = 11
        rm.TextColor3 = C.text
        rm.Text = "X"
        rm.MouseButton1Click:Connect(function()
            removeFromList(tbl, fname, key)
            renderList(parentCol, tbl, fname, tag)
        end)
    end
end

