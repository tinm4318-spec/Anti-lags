local function renderServerRow(idx, server)
    local row = Instance.new("Frame", hopScroll)
    row.Size = UDim2.new(0, 339, 0, 22)
    row.BackgroundColor3 = Color3.fromRGB(18, 10, 12)
    row.BorderColor3 = C.border
    row.BorderSizePixel = 1
    row.LayoutOrder = idx

    local isCurrent = server.id == game.JobId
    local isPrev = server.id == HopState.previousServer
    local isFull = tonumber(server.playing) >= tonumber(server.maxPlayers)

    if isCurrent then row.BackgroundColor3 = Color3.fromRGB(50, 10, 20)
    elseif isPrev then row.BackgroundColor3 = Color3.fromRGB(50, 45, 10)
    elseif isFull then row.BackgroundColor3 = Color3.fromRGB(50, 0, 0) end

    local jid = Instance.new("TextLabel", row)
    jid.Size = UDim2.new(0, 190, 0, 20)
    jid.Position = UDim2.new(0, 4, 0, 1)
    jid.BackgroundTransparency = 1
    jid.FontFace = FONT
    jid.TextSize = 10
    jid.TextColor3 = C.muted
    jid.TextXAlignment = Enum.TextXAlignment.Left
    jid.TextTruncate = Enum.TextTruncate.AtEnd
    jid.Text = server.id
    if isCurrent then jid.Text = server.id .. " (you)" end
    if isPrev then jid.Text = server.id .. " (prev)" end

    local cnt = Instance.new("TextLabel", row)
    cnt.Size = UDim2.new(0, 60, 0, 20)
    cnt.Position = UDim2.new(0, 200, 0, 1)
    cnt.BackgroundTransparency = 1
    cnt.FontFace = FONT
    cnt.TextSize = 10
    cnt.TextColor3 = isFull and C.bad or C.good
    cnt.Text = tostring(server.playing) .. "/" .. tostring(server.maxPlayers)

    local joinBtn = Instance.new("TextButton", row)
    joinBtn.Size = UDim2.new(0, 60, 0, 18)
    joinBtn.Position = UDim2.new(0, 272, 0, 2)
    joinBtn.BackgroundColor3 = isCurrent and C.button or C.accentD
    joinBtn.BorderColor3 = C.border
    joinBtn.BorderSizePixel = 1
    joinBtn.FontFace = FONT
    joinBtn.TextSize = 10
    joinBtn.TextColor3 = C.text
    joinBtn.Text = isCurrent and "HERE" or "JOIN"
    joinBtn.MouseButton1Click:Connect(function()
        if not isCurrent then joinServer(server.id) end
    end)
end

local function rebuildHop()
    for _, c in ipairs(hopScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    if #HopState.servers == 0 then
        local e = Instance.new("TextLabel", hopScroll)
        e.Size = UDim2.new(0, 339, 0, 40)
        e.BackgroundTransparency = 1
        e.FontFace = FONT
        e.TextSize = 11
        e.TextColor3 = C.muted
        e.Text = "no servers — press REFRESH"
        return
    end
    for i, s in ipairs(HopState.servers) do
        if type(s) == "table" and s.id and s.playing and s.maxPlayers then
            renderServerRow(i, s)
        end
    end
end

local function refreshHop()
    hopStatus.Text = "fetching..."
    hopStatus.TextColor3 = C.warn
    task.spawn(function()
        local list, limited = fetchServers(true)
        if limited then
            hopStatus.Text = "rate-limited — cached"; hopStatus.TextColor3 = C.bad
        else
            hopStatus.Text = #list .. " servers"; hopStatus.TextColor3 = C.good
        end
        rebuildHop()
    end)
end

refreshBtn.MouseButton1Click:Connect(refreshHop)
sortBtn.MouseButton1Click:Connect(function()
    HopState.sortAsc = not HopState.sortAsc
    sortBtn.Text = HopState.sortAsc and "ASC" or "DESC"
    HopState.lastFetch = 0
    refreshHop()
end)

task.spawn(function() task.wait(2) refreshHop() end)

