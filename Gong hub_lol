--========================================================
-- BOOMBOX GRABBER
--========================================================

local function normalizeId(raw)
    if not raw or raw == "" then return nil end
    local n = raw:match("rbxassetid://(%d+)") or raw:match("^(%d+)$")
    return n
end

local function isBoomboxName(n)
    if not n then return false end
    local lower = n:lower()
    return lower:find("boombox") ~= nil
        or lower:find("speaker") ~= nil
        or lower:find("radio") ~= nil
end

local function logBoomId(id, source)
    id = normalizeId(id)
    if not id then return end
    for _, e in ipairs(Boom.log) do
        if e.id == id then return end
    end
    table.insert(Boom.log, { id = id, source = source or "?", t = os.date("%H:%M:%S") })
    while #Boom.log > 100 do table.remove(Boom.log, 1) end
    if Boom.onUpdate then pcall(Boom.onUpdate) end
end

-- walk ancestor chain looking for boombox keyword
local function ancestorIsBoombox(obj)
    local p = obj
    for _ = 1, 6 do
        if not p then break end
        if p.Name and isBoomboxName(p.Name) then return true end
        if p:IsA("Tool") then return true end   -- any tool with a Sound counts
        p = p.Parent
    end
    return false
end

local function scanSound(sound)
    if not sound or not sound.SoundId or sound.SoundId == "" then return end
    if not ancestorIsBoombox(sound) then return end
    logBoomId(sound.SoundId, sound.Parent and sound.Parent.Name or "?")
end

local function startBoomWatch()
    if Boom.watching then return end
    Boom.watching = true

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Sound") then scanSound(obj) end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            for _, obj in ipairs(plr.Character:GetDescendants()) do
                if obj:IsA("Sound") then scanSound(obj) end
            end
        end
    end

    table.insert(Boom.conns, workspace.DescendantAdded:Connect(function(o)
        if o:IsA("Sound") then scanSound(o) end
    end))
    table.insert(Boom.conns, workspace.DescendantAdded:Connect(function(o)
        if o:IsA("Tool") then
            for _, c in ipairs(o:GetDescendants()) do
                if c:IsA("Sound") then scanSound(c) end
            end
        end
    end))

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            table.insert(Boom.conns, plr.CharacterAdded:Connect(function(char)
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("Sound") then scanSound(obj) end
                end
                table.insert(Boom.conns, char.DescendantAdded:Connect(function(o)
                    if o:IsA("Sound") then scanSound(o) end
                end))
            end))
        end
    end
end

local function stopBoomWatch()
    Boom.watching = false
    for _, c in ipairs(Boom.conns) do pcall(function() c:Disconnect() end) end
    Boom.conns = {}
end

-- grab from equipped tool (u equipped boombox, click this button)
local function grabEquipped()
    local char = lp.Character; if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _, s in ipairs(tool:GetDescendants()) do
                if s:IsA("Sound") and s.SoundId ~= "" then
                    logBoomId(s.SoundId, "equipped:" .. tool.Name)
                    return s.SoundId
                end
            end
            -- fallback: read a StringValue/NumberValue holding an id
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("StringValue") and normalizeId(v.Value) then
                    logBoomId(v.Value, "equipped:" .. tool.Name)
                    return v.Value
                elseif v:IsA("NumberValue") and v.Value > 1000 then
                    logBoomId(tostring(v.Value), "equipped:" .. tool.Name)
                    return tostring(v.Value)
                end
            end
        end
    end
    return nil
end

-- grab from the nearest boombox tool in the world
local function grabNearest()
    local char = lp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and (isBoomboxName(obj.Name) or obj:FindFirstChildWhichIsA("Sound")) then
            local root = obj:FindFirstChildWhichIsA("BasePart", true)
            if root then
                local d = (root.Position - myPos).Magnitude
                if d < bestDist then bestDist = d best = obj end
            end
        end
    end
    if best then
        for _, s in ipairs(best:GetDescendants()) do
            if s:IsA("Sound") and s.SoundId ~= "" then
                logBoomId(s.SoundId, "nearest:" .. best.Name)
                return s.SoundId
            end
        end
    end
    return nil
end

-- replay any logged id locally
local function playId(id)
    id = normalizeId(id); if not id then return end
    local char = lp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. id
    s.Volume = 2
    s.RollOffMaxDistance = 500
    s.RollOffMinDistance = 5
    s.Parent = hrp
    s:Play()
    s.Ended:Once(function() pcall(function() s:Destroy() end) end)
end

