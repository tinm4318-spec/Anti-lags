-- FAKE LAG
--========================================================

local function setFakeLag(on)
    if FakeLag.task then task.cancel(FakeLag.task); FakeLag.task = nil end
    FakeLag.on = on
    if not on then
        local char = lp.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        end
        return
    end
    FakeLag.task = task.spawn(function()
        while FakeLag.on do
            local char = lp.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local freeze = math.clamp(0.8 / (FakeLag.value * 3), 0.05, 0.8)
                    local thaw = math.clamp(0.2 / (FakeLag.value * 3), 0.05, 0.5)
                    hrp.Anchored = true
                    task.wait(freeze)
                    hrp.Anchored = false
                    task.wait(thaw)
                else
                    task.wait(0.2)
                end
            else
                task.wait(0.2)
            end
        end
    end)
end

