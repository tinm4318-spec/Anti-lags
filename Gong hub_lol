local function saveList(tbl, fname)
    if not supportsFiles then return end
    local out = {}
    for k in pairs(tbl) do table.insert(out, k) end
    pcall(function() writefile(fname, table.concat(out, "\n")) end)
end

local function playerKeys(plr)
    return { tostring(plr.UserId):lower(), plr.Name:lower(), plr.DisplayName:lower() }
end

local function checkList(tbl, enabled, plr)
    if not enabled or not plr then return false end
    for _, k in ipairs(playerKeys(plr)) do
        if tbl[k] then return true end
    end
    return false
end

local function isBlacklisted(plr) return checkList(Lists.blacklist, Lists.blEnabled, plr) end
local function isWhitelisted(plr) return checkList(Lists.whitelist, Lists.wlEnabled, plr) end
local function isProtected(plr) return isBlacklisted(plr) or isWhitelisted(plr) end

local function addToList(tbl, fname, entry)
    if not entry or entry == "" then return end
    local e = entry:lower(); tbl[e] = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == e or p.DisplayName:lower() == e then
            tbl[tostring(p.UserId):lower()] = true
        end
    end
    saveList(tbl, fname)
end

local function removeFromList(tbl, fname, entry)
    if not entry then return end
    tbl[entry:lower()] = nil
    saveList(tbl, fname)
end

