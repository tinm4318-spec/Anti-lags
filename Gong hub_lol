--========================================================
-- BLACKLIST HELPERS
--========================================================

local function saveBlacklist()
    if not supportsFiles then return end
    local out = {}
    for k in pairs(Blacklist.list) do table.insert(out, k) end
    pcall(function() writefile("gonghub_blacklist.txt", table.concat(out, "\n")) end)
end

local function isBlacklisted(plr)
    if not Blacklist.enabled then return false end
    if not plr then return false end
    if Blacklist.list[tostring(plr.UserId):lower()] then return true end
    if Blacklist.list[plr.Name:lower()] then return true end
    if Blacklist.list[plr.DisplayName:lower()] then return true end
    return false
end

local function addToBlacklist(entry)
    if not entry or entry == "" then return end
    local e = entry:lower()
    Blacklist.list[e] = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == e or p.DisplayName:lower() == e then
            Blacklist.list[tostring(p.UserId):lower()] = true
        end
    end
    saveBlacklist()
end

local function removeFromBlacklist(entry)
    if not entry then return end
    Blacklist.list[entry:lower()] = nil
    saveBlacklist()
end

--========================================================
-- HOPPER HELPERS
--========================================================

local function getRequest()
    return request
        or (syn and syn.request)
        or (http and http.request)
        or (fluxus and fluxus.request)
        or (krnl and krnl.request)
end

local function fetchServers(force)
    if not force and (tick() - HopState.lastFetch) < 60 and #HopState.servers > 0 then
        return HopState.servers, false
    end
    if game.PlaceId == 0 then
        return HopState.servers, true
    end

    local url = "https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder="
        ..(HopState.sortAsc and "Asc" or "Desc").."&limit=100"

    local req = getRequest()
    local body

    local ok, res = pcall(function()
        if req then
            return req({Url = url, Method = "GET"})
        end
        return {Body = game:HttpGet(url), StatusCode = 200}
    end)

    if ok and res then
        if res.StatusCode and res.StatusCode ~= 200 then
            HopState.rateLimited = true
        else
            body = res.Body
        end
    end

    if not body then
        local okFallback, fallback = pcall(game.HttpGet, game, url)
        if okFallback and fallback then
            body = fallback
            HopState.rateLimited = false
        end
    end

    if body then
        local okDecode, data = pcall(function() return HttpService:JSONDecode(body) end)
        if okDecode and data and type(data) == "table" and type(data.data) == "table" then
            HopState.servers = data.data
            HopState.lastFetch = tick()
            HopState.rateLimited = false
            return HopState.servers, false
        end
    end

    HopState.rateLimited = true
    return HopState.servers, true
end

local function joinServer(jobId)
    if not jobId or jobId == "" or jobId == game.JobId then return end
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, lp)
    end)
end

