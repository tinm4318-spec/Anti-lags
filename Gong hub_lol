local function getRequest()
    return request
        or (syn and syn.request)
        or (http and http.request)
        or (fluxus and fluxus.request)
        or (krnl and krnl.request)
end

local function fetchServers(force)
    if not force and (tick() - HopState.lastFetch) < 60 and #HopState.servers > 0 then
        return HopState.servers, false
    end
    if game.PlaceId == 0 then return HopState.servers, true end

    local url = "https://games.roblox.com/v1/games/"..tostring(game.PlaceId)
        .."/servers/Public?sortOrder="..(HopState.sortAsc and "Asc" or "Desc").."&limit=100"

    local req = getRequest()
    local body
    local ok, res = pcall(function()
        if req then return req({Url = url, Method = "GET"}) end
        return {Body = game:HttpGet(url), StatusCode = 200}
    end)

    if ok and res then
        if res.StatusCode and res.StatusCode ~= 200 then
            HopState.rateLimited = true
        else
            body = res.Body
        end
    end

    if not body then
        local okF, fb = pcall(game.HttpGet, game, url)
        if okF and fb then body = fb HopState.rateLimited = false end
    end

    if body then
        local okD, data = pcall(function() return HttpService:JSONDecode(body) end)
        if okD and data and type(data) == "table" and type(data.data) == "table" then
            HopState.servers = data.data
            HopState.lastFetch = tick()
            HopState.rateLimited = false
            return HopState.servers, false
        end
    end

    HopState.rateLimited = true
    return HopState.servers, true
end

local function joinServer(jobId)
    if not jobId or jobId == "" or jobId == game.JobId then return end
    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, lp) end)
end

