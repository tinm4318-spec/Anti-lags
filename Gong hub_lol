local function tagColor(kind)
    if kind == "self" or kind == "max-self" then return C.tagSelf end
    if kind == "prev" or kind == "max-prev" then return C.tagPrev end
    if kind == "max" then return C.tagMax end
    return C.panel
end

local function renderServers(list)
    for _, child in ipairs(serverList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    if not list or #list == 0 then
        local e = Instance.new("TextLabel", serverList)
        e.Text = "no servers found"
        e.TextColor3 = C.textDim
        e.TextSize = 12
        e.FontFace = FONT
        e.BackgroundTransparency = 1
        e.Size = UDim2.new(1, 0, 0, 24)
        return
    end
    for i, s in ipairs(list) do
        local row = Instance.new("TextButton", serverList)
        row.BackgroundColor3 = tagColor(s.tagKind)
        row.BorderSizePixel = 0
        row.Text = ""
        row.AutoButtonColor = false
        row.Size = UDim2.new(1, 0, 0, 34)
        row.LayoutOrder = i
        corner(row, 6)
        stroke(row, C.stroke, 1)

        local fill = (s.max > 0) and (s.playing / s.max) or 0
        local bar = Instance.new("Frame", row)
        bar.BackgroundColor3 = C.accentDim
        bar.BorderSizePixel = 0
        bar.Size = UDim2.new(fill * 0.98, 0, 1, 0)
        bar.BackgroundTransparency = 0.8
        bar.ZIndex = 1
        corner(bar, 6)

        local lbl = Instance.new("TextLabel", row)
        lbl.BackgroundTransparency = 1
        lbl.ZIndex = 2
        lbl.Text = string.format("%d/%d · ping %d%s",
            s.playing, s.max, s.ping or 0,
            (s.tag ~= "" and (" · " .. s.tag) or ""))
        lbl.TextColor3 = C.text
        lbl.TextSize = 12
        lbl.FontFace = FONT
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Size = UDim2.new(1, -80, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)

        local join = Instance.new("TextButton", row)
        join.ZIndex = 3
        join.Text = "Join"
        join.TextSize = 12
        join.TextColor3 = C.bg
        join.BackgroundColor3 = C.accent
        join.BorderSizePixel = 0
        join.FontFace = FONT
        join.Size = UDim2.new(0, 60, 0, 22)
        join.Position = UDim2.new(1, -70, 0.5, -11)
        corner(join, 5)

        join.MouseButton1Click:Connect(function()
            if s.id == game.JobId then
                hopStatus.Text = "already in that server"
                hopStatus.TextColor3 = C.danger
                return
            end
            hopStatus.Text = "teleporting..."
            hopStatus.TextColor3 = C.accent
            Hopper.hop(s.id)
        end)
    end
end

local function onRefresh(list, err)
    if err then
        hopStatus.Text = err == "busy" and "still fetching..." or ("fetch failed: " .. err)
        hopStatus.TextColor3 = err == "busy" and C.textDim or C.danger
        return
    end
    hopStatus.Text = "ready"
    hopStatus.TextColor3 = C.good
    hopCount.Text = string.format("servers: %d", #list)
    renderServers(list)
end

