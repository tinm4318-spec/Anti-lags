-- ============================================================
local Hopper = {}

local function httpGet(url)
    local req = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
    if req then
        local ok, res = pcall(function()
            return req({ Url = url, Method = "GET" })
        end)
        if ok and res and res.Body then return res.Body end
    end
    local ok2, body = pcall(function() return game:HttpGet(url) end)
    if ok2 then return body end
    return nil
end

local PREV_FILE = "gonghub_prevserver.txt"
local supportsFiles = false
local memoryPrev = "0"

pcall(function()
    writefile(PREV_FILE, "0")
    if readfile(PREV_FILE) == "0" then
        supportsFiles = true
    end
end)

local function readPrev()
    if supportsFiles then
        local ok, v = pcall(function() return readfile(PREV_FILE) end)
        if ok and v and v ~= "" then return v end
    end
    return memoryPrev
end

local function writePrev(jobId)
    memoryPrev = tostring(jobId)
    if supportsFiles then
        pcall(function() writefile(PREV_FILE, memoryPrev) end)
    end
end

Hopper._state = { asc = false, refreshing = false, destroyed = false, servers = {} }
local RATE_LIMIT_WAIT = 70
local POST_FETCH_WAIT = 3

local function fetchServers()
    local order = Hopper._state.asc and "Asc" or "Desc"
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100",
        game.PlaceId, order
    )
    local body = httpGet(url)
    if not body then return nil, "network" end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
        return nil, "rate limited"
    end

    local list = {}
    local currJob = game.JobId
    local prevJob = readPrev()

    for _, v in ipairs(decoded.data) do
        if type(v) == "table" and v.id and v.playing and v.maxPlayers then
            local playing = tonumber(v.playing) or 0
            local max = tonumber(v.maxPlayers) or 0
            local tag, tagKind = "", "none"

            if playing >= max and max > 0 then
                if v.id == currJob then tag, tagKind = "max + your server", "max-self"
                elseif tostring(v.id) == tostring(prevJob) then tag, tagKind = "max + previous server", "max-prev"
                else tag, tagKind = "max", "max" end
            else
                if v.id == currJob then tag, tagKind = "your server", "self"
                elseif tostring(v.id) == tostring(prevJob) then tag, tagKind = "previous server", "prev" end
            end

            table.insert(list, {
                id = v.id, playing = playing, max = max,
                ping = tonumber(v.ping) or 0, tag = tag, tagKind = tagKind,
            })
        end
    end

    return list, nil
end

local function sortServers(list)
    local priority = { self = 0, prev = 1, ["max-self"] = 2, ["max-prev"] = 3, max = 4, none = 5 }
    table.sort(list, function(a, b)
        local pa = priority[a.tagKind] or 5
        local pb = priority[b.tagKind] or 5
        if pa ~= pb then return pa < pb end
        if a.playing == b.playing then return a.ping < b.ping end
        return a.playing > b.playing
    end)
end

function Hopper.setAscending(v) Hopper._state.asc = v and true or false end
function Hopper.isAscending() return Hopper._state.asc end
function Hopper.getCached() return Hopper._state.servers end

function Hopper.refresh(cb)
    if Hopper._state.refreshing then
        if cb then cb(Hopper._state.servers, "busy") end
        return
    end
    Hopper._state.refreshing = true

    task.spawn(function()
        local list, err = fetchServers()
        if err then
            Hopper._state.refreshing = false
            if cb then cb(nil, err) end
            return
        end
        sortServers(list)
        Hopper._state.servers = list
        task.wait(POST_FETCH_WAIT)
        Hopper._state.refreshing = false
        if cb then cb(list, nil) end
    end)
end

function Hopper.hop(jobId)
    if not jobId or jobId == "" then return false end
    if jobId == game.JobId then return false end
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
    end)
    return ok
end

function Hopper.hopToHighest()
    for _, s in ipairs(Hopper._state.servers) do
        if s.id ~= game.JobId then
            return Hopper.hop(s.id)
        end
    end
    return false
end

function Hopper.startAutoRefresh(cb)
    if Hopper._loop then return end
    Hopper._loop = true
    task.spawn(function()
        Hopper.refresh(cb)
        while not Hopper._state.destroyed do
            task.wait(RATE_LIMIT_WAIT)
            if Hopper._state.destroyed then break end
            Hopper.refresh(cb)
        end
    end)
end

function Hopper.destroy() Hopper._state.destroyed = true end

Players.PlayerRemoving:Connect(function(plr)
