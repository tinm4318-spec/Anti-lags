local function nukeBurst()
    local char = lp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local center = hrp.Position
    local radius = Grief.radius

    local protected = playerCharSet()
    local toKill = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local ok = true
            -- skip self
            if char:IsAncestorOf(obj) then ok = false end
            -- skip protected characters
            if ok and protected[obj] then ok = false end
            -- skip spawn location if keepSpawn
            if ok and Grief.keepSpawn and obj:IsA("SpawnLocation") then ok = false end
            -- skip anchored if keepAnchor
            if ok and Grief.keepAnchor and obj.Anchored then ok = false end
            -- skip terrain
            if ok and obj.Parent == workspace.Terrain then ok = false end
            -- radius filter (huge radius = whole map)
            if ok and (obj.Position - center).Magnitude <= radius then
                table.insert(toKill, obj)
            end
        end
    end

    -- batched destroy to avoid the delete-spam kick
    task.spawn(function()
        local i = 1
        while i <= #toKill do
            local slice = math.min(i + Grief.batchSize - 1, #toKill)
            for j = i, slice do
                pcall(function() toKill[j]:Destroy() end)
            end
            i = slice + 1
            task.wait(Grief.delay)
        end
    end)

    return #toKill
end

local function startNuke()
    if Grief.nuking then return end
    Grief.nuking = true
    task.spawn(function()
        while Grief.nuking do
            pcall(nukeBurst)
            task.wait(1)
        end
    end)
end

local function stopNuke()
    Grief.nuking = false
end

