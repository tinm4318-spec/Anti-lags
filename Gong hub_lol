local function espCreateName(plr)
    local char = plr.Character; if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    local old = head:FindFirstChild("GH_ESPName"); if old then old:Destroy() end
    local bb = Instance.new("BillboardGui")
    bb.Name = "GH_ESPName"
    bb.Size = UDim2.new(0, 200, 0, 30)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.Adornee = head
    bb.AlwaysOnTop = true
    bb.Enabled = true
    bb.Parent = head
    local lbl = Instance.new("TextLabel")
    lbl.Name = "NameLabel"
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = plr.Name
    lbl.TextColor3 = ESPState.color
    lbl.TextStrokeTransparency = 0
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.TextSize = 14
    lbl.Font = Enum.Font.GothamSemibold
    lbl.Parent = bb
    ESPState.guis[plr] = ESPState.guis[plr] or {}
    ESPState.guis[plr].name = bb
end

local function espCreateOutline(plr)
    local char = plr.Character; if not char then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Highlight") and v.Name == "GH_ESPOutline" then v:Destroy() end
    end
    local hl = Instance.new("Highlight")
    hl.Name = "GH_ESPOutline"
    hl.FillTransparency = 1
    hl.OutlineColor = ESPState.color
    hl.OutlineTransparency = 0
    hl.Parent = char
    ESPState.guis[plr] = ESPState.guis[plr] or {}
    ESPState.guis[plr].outline = hl
end

local function espRemove(plr)
    local data = ESPState.guis[plr]
    if not data then return end
    if data.name then pcall(function() data.name:Destroy() end) end
    if data.outline then pcall(function() data.outline:Destroy() end) end
    ESPState.guis[plr] = nil
end

local function espStartRender()
    if ESPState.renderConn then ESPState.renderConn:Disconnect(); ESPState.renderConn = nil end
    ESPState.renderConn = addConn(RunService.RenderStepped:Connect(function()
        if not ESPState.on then return end
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        for plr, data in pairs(ESPState.guis) do
            local pchar = plr.Character
            local phrp = pchar and pchar:FindFirstChild("HumanoidRootPart")
            local ok = true
            if hrp and phrp then
                ok = (hrp.Position - phrp.Position).Magnitude <= ESPState.maxDist
            end
            if data.name then data.name.Enabled = ok and (ESPState.showNames or ESPState.showDist) end
            if data.name and data.name.Enabled then
                local n = plr.Name
                local d = phrp and hrp and string.format("%.0f", (hrp.Position - phrp.Position).Magnitude) or "?"
                if ESPState.showNames and ESPState.showDist then
                    data.name.NameLabel.Text = n .. " [" .. d .. "]"
                elseif ESPState.showNames then
                    data.name.NameLabel.Text = n
                else
                    data.name.NameLabel.Text = d
                end
                data.name.NameLabel.TextColor3 = ESPState.color
            end
            if data.outline then
                data.outline.Enabled = ok and ESPState.showOutline
                data.outline.OutlineColor = ESPState.color
            end
        end
    end))
end

