    local keys = {}
    for k in pairs(Blacklist.list) do table.insert(keys, k) end
    table.sort(keys)
    if #keys == 0 then
        local empty = Instance.new("TextLabel", blScroll)
        empty.Size = UDim2.new(0, 339, 0, 40)
        empty.BackgroundTransparency = 1
        empty.FontFace = FONT
        empty.TextSize = 11
        empty.TextColor3 = C.muted
        empty.Text = "blacklist empty — add a name or userid above"
        empty.LayoutOrder = 1
        return
    end
    for i, key in ipairs(keys) do
        local row = Instance.new("Frame", blScroll)
        row.Size = UDim2.new(0, 339, 0, 20)
        row.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
