            return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
        end)
    end
    local limit = math.min(#bricks, 80)
    for i = 1, limit do
        local brick = bricks[i]
        if brick and brick.Parent then
            local h = Instance.new("Highlight")
            h.Adornee = brick
            h.FillColor = Color3.fromRGB(255, 0, 0)
            h.OutlineColor = Color3.fromRGB(255, 0, 0)
            h.FillTransparency = 0.5
            h.OutlineTransparency = 1
            h.Parent = brick
            table.insert(highlights, h)
        end
    end
end

local function startAura()
    if not refreshToolStatus() then
        auraStatus.Text = "aura: no delete tool"
        auraStatus.TextColor3 = C.danger
        return
    end

    auraActive = true
    auraStatus.Text = "aura: running"
    auraStatus.TextColor3 = C.good
    startBtn.Text = "Stop Delete Aura"
    startBtn.BackgroundColor3 = C.danger

    auraLoop = safeTaskSpawn(function()
        local dti = 0
        local lastRefresh = tick()

        while auraActive do
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then
                safeWait(0.5)
            else
                local tools = findDeleteTools()

                if #tools == 0 then
                    auraStatus.Text = "aura: delete tool lost"
                    auraStatus.TextColor3 = C.danger
                    auraActive = false
                    break
                end

                if tick() - lastRefresh >= TOOL_REFRESH then
                    lastRefresh = tick()
                end

                local bricks = getAllBricks()
                blockCount.Text = string.format("blocks targetable: %d", #bricks)

                for _, brick in ipairs(bricks) do
                    if not auraActive then break end
                    if brick and brick:IsDescendantOf(workspace) then
                        dti = dti + 1
                        local tool = tools[(dti % #tools) + 1]
                        pcall(function()
                            tool.e:FireServer(brick, hrp.Position)
                        end)
                        safeWait(FIRE_DELAY / math.max(#tools, 1))
                    end
                end
            end
            safeWait(0.05)
        end

        auraActive = false
    end)
end

local function stopAura()
    auraActive = false
    auraStatus.Text = "aura: stopped"
    auraStatus.TextColor3 = C.textDim
    startBtn.Text = "Start Delete Aura"
    startBtn.BackgroundColor3 = C.accent
    startBtn.TextColor3 = C.bg
    if auraLoop then
        pcall(function() task.cancel(auraLoop) end)
        auraLoop = nil
    end
end

local function toggleAura()
    if auraActive then
        stopAura()
    else
        startAura()
    end
end

local function startHighlight()
    if hlActive then return end
    hlActive = true
    hlBtn.Text = "Highlight Blocks: ON"
    hlBtn.BackgroundColor3 = C.accentDim
    hlStatus.Text = "highlight: on (refreshes 1s)"
    hlStatus.TextColor3 = C.good
    hlLoop = safeTaskSpawn(function()
        while hlActive do
            applyHighlights()
            safeWait(1)
        end
        clearHighlights()
    end)
end

local function stopHighlight()
    hlActive = false
    hlBtn.Text = "Highlight Blocks: OFF"
    hlBtn.BackgroundColor3 = C.panelAlt
    hlStatus.Text = "highlight: off"
    hlStatus.TextColor3 = C.textDim
    if hlLoop then
        pcall(function() task.cancel(hlLoop) end)
        hlLoop = nil
    end
    clearHighlights()
end

startBtn.MouseButton1Click:Connect(toggleAura)
hlBtn.MouseButton1Click:Connect(function()
    if hlActive then stopHighlight() else startHighlight() end
end)
refreshStatusBtn.MouseButton1Click:Connect(function()
    refreshToolStatus()
    local bricks = getAllBricks()
    blockCount.Text = string.format("blocks targetable: %d", #bricks)
end)

-- periodic tool check while idle
safeTaskSpawn(function()
    while gui.Parent do
        if not auraActive then
            refreshToolStatus()
            local bricks = getAllBricks()
            blockCount.Text = string.format("blocks targetable: %d", #bricks)
        end
        safeWait(3)
    end
end)

-- cleanup on gui death
gui.Destroying:Connect(function()
    auraActive = false
    hlActive = false
    clearHighlights()
    if auraLoop then pcall(function() task.cancel(auraLoop) end) end
    if hlLoop then pcall(function() task.cancel(hlLoop) end) end
end)
