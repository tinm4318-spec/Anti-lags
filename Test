function GH.finite(v)
    return v.X == v.X and v.Y == v.Y and v.Z == v.Z
        and math.abs(v.X) < 1e9 and math.abs(v.Y) < 1e9 and math.abs(v.Z) < 1e9
end

function GH.tp.allow(sec)
    GH.tp.allowUntil = os.clock() + (sec or 1.5)
end

function GH.tpStep()
    local t = GH.tp
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        t.safe = nil
        t.char = nil
        return
    end
    if char ~= t.char then
        t.char = char
        t.safe = nil
    end
    local pos = root.Position
    if not GH.finite(pos) then
        if t.safe then
            root.CFrame = t.safe
            root.AssemblyLinearVelocity = Vector3.zero
        end
        return
    end
    if not t.safe or os.clock() < t.allowUntil then
        t.safe = root.CFrame
        return
    end
    if (pos - t.safe.Position).Magnitude > t.maxStep then
        root.CFrame = t.safe
        root.AssemblyLinearVelocity = Vector3.zero
    else
        t.safe = root.CFrame
    end
end

function GH.tpEnable()
    if GH.tp.conn then return end
    GH.tp.safe = nil
    GH.tp.conn = runService.PostSimulation:Connect(GH.tpStep)
end

function GH.tpDisable()
    if GH.tp.conn then
        GH.tp.conn:Disconnect()
        GH.tp.conn = nil
    end
    GH.tp.safe = nil
    GH.tp.char = nil
end

function GH.voidStep()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = root.Position
    if not GH.finite(pos) then return end
    local floatY = GH.void.orig + 30
    if pos.Y < floatY then
        GH.tp.allow(0.5)
        root.CFrame = root.CFrame + Vector3.new(0, floatY - pos.Y, 0)
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

function GH.voidEnable()
