textChatService.OnIncomingMessage = function(mdata)
    if not mdata or not mdata.Text or mdata.Text == "" then return end

    local src = mdata.TextSource and mdata.TextSource.UserId
        and players:GetPlayerByUserId(mdata.TextSource.UserId)
    if not src then return end

    local cn = ""
    local hidden = false

    if src.Neutral == true then
        if src:GetAttribute("Arken") == true then
            cn = "arken"
        else
            cn = "peasant"
        end
    else
        cn = "admin"
    end

    local muted = src:HasTag("Muted")
    if muted then
        cn = "hidden"
        if not spyChat and src ~= localPlayer then
            mdata.Text = ""
        end
    end

    local cmd = string.sub(mdata.Text, 1, string.find(mdata.Text, " ") or nil)
    if string.sub(mdata.Text, 1, 1) == ";" then
        cmd = string.sub(mdata.Text, 2, string.find(mdata.Text, " ") or nil)
        if spyChat then
            cn = "hidden"
            hidden = true
        else
            if src ~= localPlayer then
                mdata.Text = ""
            end
        end
    end

    local iq = nil
    if spyChat and src:GetAttribute("IQ") then
        if src:GetAttribute("IQ") >= 200 then
            iq = "genius 🧠"
            cn = "iqgenius"
        elseif src:GetAttribute("IQ") <= 50 then
            iq = "dumb 🤪"
            cn = "iqdumb"
        end
    end

    local hiddenTag = hidden and " (HIDDEN CHAT)" or ""
    local iqTag     = iq and (" (" .. iq .. ")") or ""
    local mutedTag  = muted and " (MUTED)" or ""

    if cubes then
        mdata.PrefixText = '<font color="' .. colorHex[cn] .. '"><b><font color=\'rgb('
            .. tostring(colorMap[cn][1]) .. ","
            .. tostring(colorMap[cn][2]) .. ","
            .. tostring(colorMap[cn][3]) .. ")'>["
            .. src.DisplayName .. hiddenTag .. iqTag .. mutedTag
            .. "]: </font></b></font>"
    else
        mdata.PrefixText = '<font color="' .. colorHex[cn] .. '"><i><font color=\'rgb('
            .. tostring(colorMap[cn][1]) .. ","
            .. tostring(colorMap[cn][2]) .. ","
            .. tostring(colorMap[cn][3]) .. ")'>("
            .. src.DisplayName .. hiddenTag .. iqTag .. mutedTag
            .. ") </font></i></font>"
    end
end

