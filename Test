function GH.wrap(tab, tabName)
    if type(tab) ~= "table" then return tab end
    local okGet, orig = pcall(function() return tab.Toggle end)
    if not okGet or type(orig) ~= "function" then return tab end
    local okSet = pcall(function()
        tab.Toggle = function(self, cfg)
            if type(cfg) ~= "table" or not cfg.Title then return orig(self, cfg) end
            local key = tostring(tabName) .. "/" .. tostring(cfg.Title)
            local cb = cfg.Callback
            local baseline = cfg.Value == true
            local start = baseline
            if type(GH.data[key]) == "boolean" then start = GH.data[key] end
            cfg.Value = start
            cfg.Callback = function(v)
                if GH.building then return end
                GH.data[key] = v
                GH.save()
                if cb then cb(v) end
            end
            if cb then table.insert(GH.entries, { cb = cb, start = start, baseline = baseline }) end
            return orig(self, cfg)
        end
    end)
    if not okSet then warn("[GongHub] toggle saving unavailable for " .. tostring(tabName)) end
    return tab
end

function GH.finish()
    GH.building = false
    GH.restoring = true
    local list = GH.entries
    GH.entries = {}
    for _, e in ipairs(list) do
        if e.start ~= e.baseline then
            task.spawn(function()
                local ok, err = pcall(e.cb, e.start)
                if not ok then warn("[GongHub] restore failed: " .. tostring(err)) end
            end)
        end
    end
    GH.restoring = false
end

