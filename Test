local function randomAroundSphere(hrp, lo, hi)
    local r  = math.random() * (hi - lo) + lo
    local th = math.random() * math.pi * 2
    local ph = math.acos(2 * math.random() - 1)
    return hrp.Position + Vector3.new(
        r * math.sin(ph) * math.cos(th),
        r * math.cos(ph),
        r * math.sin(ph) * math.sin(th)
    )
end

local function nearestBrickInRange(range)
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local folder = workspace:FindFirstChild("Bricks") or workspace:FindFirstChild("PlacedBlocks")
    if not folder then return nil end
    local ok, found = pcall(function()
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { folder }
        params.MaxParts = 200
        return workspace:GetPartBoundsInRadius(hrp.Position, range, params)
    end)
    if ok and type(found) == "table" then
        return #found > 0 and found[math.random(1, #found)] or nil
    end
    local pool = {}
    for _, p in ipairs(folder:GetDescendants()) do
        if p:IsA("BasePart") and (hrp.Position - p.Position).Magnitude <= range then
            table.insert(pool, p)
        end
    end
    return #pool > 0 and pool[math.random(1, #pool)] or nil
end

