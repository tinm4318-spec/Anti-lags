buildTab:Button({
    Title = "Build Cube",
    Callback = function()
        if building then return end
        local hrp = getHrp()
        if not hrp then return end
        local buildEvent = equipAndEvent("Build")
        if not buildEvent then
            WindUI:Notify({ Title = "Build", Content = "Equip Build first.", Duration = 2 })
            return
        end
        building = true
        local total = cubeSize * cubeSize * cubeSize
        WindUI:Notify({ Title = "Building",
            Content = cubeSize .. "^3 = " .. total .. " blocks", Duration = 3 })
        task.spawn(function()
            local origin = hrp.Position + Vector3.new(0, 2, -cubeSize * 4)
            local savedCF = hrp.CFrame
            local center = Vector3.new(
                (cubeSize - 1) * 4 / 2, (cubeSize - 1) * 4 / 2, (cubeSize - 1) * 4 / 2)
            hrp.CFrame = CFrame.new(origin + center)
            for layer = 0, cubeSize - 1 do
                local row = {}
                for i = 0, cubeSize - 1 do
                    for j = 0, cubeSize - 1 do
                        table.insert(row, Vector3.new(
                            origin.X + i * 4, origin.Y + layer * 4, origin.Z + j * 4))
                    end
                end
                table.sort(row, function(a, b)
                    return (a.X - origin.X) / 4 + (a.Z - origin.Z) / 4
                        < (b.X - origin.X) / 4 + (b.Z - origin.Z) / 4
                end)
                for _, p in ipairs(row) do
                    if not building then break end
                    buildEvent:FireServer(workspace.Terrain, Enum.NormalId.Top, p, "normal")
                    task.wait(userInputService.TouchEnabled and 0.1 or 0.05)
                end
                task.wait(0.1)
            end
            hrp.CFrame = savedCF
            building = false
            WindUI:Notify({ Title = "Done", Content = total .. " blocks placed.", Duration = 3 })
        end)
    end,
