local function say(msg)
    local ok = pcall(function()
        replicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
    end)
    if ok then return end
    if pcall(function() textChatService.TextChannels.RBXGeneral:SendAsync(msg) end) then return end
    pcall(function()
        for _, r in pairs(replicatedStorage:GetDescendants()) do
            if r:IsA("RemoteEvent")
                and (r.Name:lower():find("say") or r.Name:lower():find("chat")
                    or r.Name:lower():find("message")) then
                r:FireServer(msg, "All")
                break
            end
        end
    end)
end

local function buildStash(position)
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    for i = #stashPlatforms, 1, -1 do
        local p = stashPlatforms[i]
        if p and p.Parent then p:Destroy() end
        table.remove(stashPlatforms, i)
    end
    for x = -2, 2 do
        for z = -2, 2 do
            local part = Instance.new("Part")
            part.Name = "GongHubStashPlatform"
            part.Size = Vector3.new(4, 1, 4)
            part.CFrame = CFrame.new(position + Vector3.new(x * 4, 0, z * 4))
            part.Anchored = true
            part.CanCollide = true
            part.Locked = true
            part.Color = Color3.fromRGB(30, 30, 30)
            part.Material = Enum.Material.SmoothPlastic
            part.CastShadow = false
            part.Parent = workspace
            table.insert(stashPlatforms, part)
        end
    end
    hrp.CFrame = CFrame.new(position + Vector3.new(0, 6, 0))
end

local function clearStash()
    for i = #stashPlatforms, 1, -1 do
        local p = stashPlatforms[i]
        if p and p.Parent then p:Destroy() end
        table.remove(stashPlatforms, i)
    end
end

