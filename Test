function GH.statusFormat(n)
    local s = tostring(math.floor(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

function GH.statusPlayers()
    return #players:GetPlayers() .. " / " .. players.MaxPlayers
end

function GH.statusUptime()
    local t = math.floor(workspace.DistributedGameTime)
    return string.format("%dh %02dm %02ds", math.floor(t / 3600), math.floor(t % 3600 / 60), t % 60)
end

function GH.statusBricks()
    local folder = workspace:FindFirstChild("Bricks") or workspace:FindFirstChild("PlacedBlocks")
    if not folder then return "N/A (no Bricks folder)" end
    local total = 0
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("BasePart") then
            total = total + 1
        else
            for _, p in ipairs(child:GetChildren()) do
                if p:IsA("BasePart") then total = total + 1 end
            end
        end
    end
    return GH.statusFormat(total)
end

function GH.statusUpdate(withBricks)
    local s = GH.status
    pcall(function() s.players:SetDesc(GH.statusPlayers()) end)
    pcall(function() s.uptime:SetDesc(GH.statusUptime()) end)
    if withBricks then
        pcall(function() s.bricks:SetDesc(GH.statusBricks()) end)
    end
end

function GH.statusAuto(on)
    local s = GH.status
    s.gen = s.gen + 1
    if not on then return end
    local gen = s.gen
    task.spawn(function()
        local n = 0
        while s.gen == gen and GH.alive do
            task.wait(1)
            if s.gen ~= gen then break end
            n = n + 1
            GH.statusUpdate(n % 5 == 0)
        end
    end)
end

