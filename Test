local function getPlayerInventory(player)
    local inventory = {}
    if player.Character then
        for _, item in ipairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(inventory, item.Name)
            end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(inventory, item.Name)
            end
        end
    end
    if #inventory == 0 then
        table.insert(inventory, "No Items")
    end
    return inventory
end

local function removeInvGui(player)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local existing = head:FindFirstChild("InventoryDisplay")
    if existing then existing:Destroy() end
end

local function createInvGui(player)
    if player == localPlayer then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local existing = head:FindFirstChild("InventoryDisplay")
    if existing then existing:Destroy() end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "InventoryDisplay"
    billboard.Size = UDim2.new(5, 0, 2, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextScaled = true
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Parent = billboard
end

local function updateInvGui(player)
    if player == localPlayer then return end
    if not invDisplayEnabled then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local billboard = head:FindFirstChild("InventoryDisplay")
    if not billboard then
        createInvGui(player)
        billboard = head:FindFirstChild("InventoryDisplay")
    end
    local textLabel = billboard and billboard:FindFirstChildOfClass("TextLabel")
    if textLabel then
        textLabel.Text = table.concat(getPlayerInventory(player), ", ")
    end
end

local function stopInvTracking(player)
    if invDisplayTasks[player] then
        task.cancel(invDisplayTasks[player])
        invDisplayTasks[player] = nil
    end
    removeInvGui(player)
end

local function trackInvPlayer(player)
    if player == localPlayer then return end
    stopInvTracking(player)
    invDisplayTasks[player] = task.spawn(function()
        while invDisplayEnabled and player.Parent do
            updateInvGui(player)
            task.wait(1)
        end
        removeInvGui(player)
        invDisplayTasks[player] = nil
    end)
end

local function enableInvDisplay()
    invDisplayEnabled = true
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= localPlayer then trackInvPlayer(p) end
    end
    if not invDisplayPlayerAdded then
        invDisplayPlayerAdded = players.PlayerAdded:Connect(function(p)
            if p ~= localPlayer and invDisplayEnabled then
                trackInvPlayer(p)
            end
        end)
    end
end

local function disableInvDisplay()
    invDisplayEnabled = false
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= localPlayer then stopInvTracking(p) end
    end
    if invDisplayPlayerAdded then
        invDisplayPlayerAdded:Disconnect()
        invDisplayPlayerAdded = nil
    end
end

GH.inv = {
    enable = enableInvDisplay,
    disable = disableInvDisplay,
    on = function() return invDisplayEnabled end,
