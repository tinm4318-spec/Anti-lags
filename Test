function GH.lockProbe()
    if GH.lock.api == "" then return "not set" end
    if not _req then return "no request function" end
    local ok, res = pcall(_req, { Url = GH.lock.api .. "?t=" .. os.time(), Method = "GET" })
    if not ok or type(res) ~= "table" then return "request failed" end
    local body = type(res.Body) == "string" and (res.Body:sub(1, 40):gsub("%s+", " ")) or ""
    return "HTTP " .. tostring(res.StatusCode) .. " " .. body
end

function GH.lockSet(v)
    local function note(text)
        WindUI:Notify({ Title = "Owner Lock", Content = text, Duration = 3 })
    end
    if GH.lock.api == "" then
        note("Backend URL is not set.")
        return false
    end
    if not _req then
        note("This executor has no request function.")
        return false
    end
    local okT, raw = pcall(readfile, GH.lock.tokenFile)
    local token = okT and type(raw) == "string" and raw:match("^%s*(.-)%s*$") or ""
    if token == "" then
        note("Owner token is missing.")
        return false
    end
    local ok, res = pcall(_req, {
        Url = GH.lock.api,
        Method = "POST",
        Headers = { Authorization = token, ["Content-Type"] = "text/plain" },
        Body = v and "true" or "false",
    })
    if not ok or type(res) ~= "table" then
        note("Request failed.")
        return false
    end
    if res.StatusCode == 200 then
        GH.lock.on = v
        GH.lock.at = os.clock()
        note(v and "Owner Lock is ON." or "Owner Lock is OFF.")
        return true
    end
    local detail = type(res.Body) == "string" and (res.Body:sub(1, 40):gsub("%s+", " ")) or ""
    note("Server answered " .. tostring(res.StatusCode) .. (res.StatusCode == 403 and " (wrong token)" or "") .. ": " .. detail)
    return false
end

