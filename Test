local lastSafePos = nil

runService.RenderStepped:Connect(function()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    hue = (hue + hueSpeed) % 1
    local rainbowCol = Color3.fromHSV(hue, 1, 1)
    local mousePos = localPlayer:GetMouse().Hit.Position

    if rainbowPaint then
        equipTool("Paint")
        local paint = toolEvent("Paint")
        if paint then
            paint:FireServer(workspace.Terrain, Enum.NormalId.Top, mousePos,
                "both 🤝", rainbowCol, material, "")
        end
    end

    if killAura then
        local nearest, nearestDist = nil, deleteRange
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer and p.Character
                and p.Character:FindFirstChild("HumanoidRootPart") then
                local d = (p.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < nearestDist then
                    nearest = p.Character.HumanoidRootPart
                    nearestDist = d
                end
            end
        end
        if nearest then
            equipTool("Build") equipTool("Paint")
            local build = toolEvent("Build") local paint = toolEvent("Paint")
            if build and paint then
                local folder = workspace:FindFirstChild("Bricks")
                local mine = folder and folder:FindFirstChild(localPlayer.Name)
                build:FireServer(workspace.Terrain, Enum.NormalId.Top, nearest.Position, "detailed")
                local kids = mine and mine:GetChildren()
                local newBrick = kids and kids[#kids]
                if newBrick then
                    paint:FireServer(newBrick, Enum.NormalId.Top, nearest.Position,
                        "both 🤝", Color3.new(0,0,0), "toxic", "")
                end
            end
        end
    end

    if shovel then
        equipTool("Shovel")
        local s = toolEvent("Shovel")
        if s then s:FireServer(workspace.Terrain, Enum.NormalId.Top, mousePos, "dig") end
    end

    if deleteMode then
        equipTool("Delete")
        local d = toolEvent("Delete")
        if d then
            local hit = workspace:Raycast(hrp.Position, (mousePos - hrp.Position).Unit * deleteRange)
            local target = hit and hit.Instance
            if target and not target:IsA("BasePart") then
                target = target:FindFirstAncestorWhichIsA("BasePart")
            end
            d:FireServer(target or workspace.Terrain, hrp.Position)
        end
    end

    if blockTrail then
        equipTool("Build")
        local b = toolEvent("Build")
        if b then
            local isRainbow = trailType:find("rainbow") ~= nil
            local kind = trailType:gsub("rainbow ", "")
            b:FireServer(workspace.Terrain, Enum.NormalId.Top, hrp.Position, kind)
            if isRainbow then
                equipTool("Paint")
                local paint = toolEvent("Paint")
                local folder = workspace:FindFirstChild("Bricks")
                local mine = folder and folder:FindFirstChild(localPlayer.Name)
                local kids = mine and mine:GetChildren()
                local newBrick = kids and kids[#kids]
                if paint and newBrick then
                    paint:FireServer(newBrick, Enum.NormalId.Top, hrp.Position,
                        "both 🤝", rainbowCol, material, "")
                end
            end
        end
    end

    if buildAura then
        local b = toolEvent("Build")
        if b then
            b:FireServer(workspace.Terrain, Enum.NormalId.Top,
                randomAroundSphere(hrp, 3, 15), "normal")
        end
    end

    if deleteAura then
        local d = toolEvent("Delete")
        local target = nearestBrickInRange(deleteRange2)
        if d and target then d:FireServer(target, hrp.Position) end
    end

    if signAura then
        local s = toolEvent("Sign")
        if s then
            s:FireServer(workspace.Terrain, Enum.NormalId.Top,
                randomAroundSphere(hrp, 3, 15), "normal")
        end
    end

    if rainbowAura then
        local p = toolEvent("Paint")
        local target = nearestBrickInRange(paintRange)
        if p and target then
            p:FireServer(target, Enum.NormalId.Top, hrp.Position,
                "both 🤝", rainbowCol, "plastic", "")
        end
    end

    if antiMorph and char:FindFirstChildOfClass("Humanoid")
        and char:FindFirstChildOfClass("Humanoid").Health > 0 then
        local name = char.Name
        local disp = char:GetAttribute("DisplayName") or char.Name
        local blacklist = { "Enlightened", "Void", "Ghost", "Loading...", "R6", "R15" }
        local okName = name == localPlayer.Name
        local okDisp = disp == localPlayer.DisplayName or disp == localPlayer.Name
        for _, v in ipairs(blacklist) do
            if name == v then okName = true end
            if disp == v then okDisp = true end
        end
        if not okName or not okDisp then killSelf() end
    end

    if antiGlitch and lastSafePos then
        if (hrp.Position - lastSafePos).Magnitude > 1000 then
            hrp.Velocity = Vector3.zero
            hrp.CFrame = CFrame.new(lastSafePos)
        end
    end
    if hrp.Position.Y > -50 and hrp.Position.Y < 5000 then
        lastSafePos = hrp.Position
    end

    if antiBlind then
        local blind = playerGui:FindFirstChild("Blind")
        if blind then
            blind.Enabled = false
            for _, d in ipairs(blind:GetDescendants()) do
                if d:IsA("Frame") or d:IsA("ImageLabel") then d.Visible = false end
            end
        end
    end

    if antiMyopic then
        local blur = lighting:FindFirstChildOfClass("BlurEffect")
        if blur then blur.Enabled = false blur.Size = 0 end
    end

    if antiVamp then
        local cam = workspace.CurrentCamera
        if cam and cam.CameraType ~= Enum.CameraType.Custom then
            cam.CameraType = Enum.CameraType.Custom
        end
    end

    if antiFog and atmo then atmo.Density = 0 end

    if antiColorless then
        for _, e in ipairs(lighting:GetChildren()) do
            if e:IsA("ColorCorrectionEffect") and e.Saturation < -0.5 then
                e.Saturation = 0 e.Contrast = 0 e.Brightness = 0 e.TintColor = Color3.new(1,1,1)
            end
        end
        for _, g in ipairs(playerGui:GetChildren()) do
            if g.Name:lower():find("colorless") and g:IsA("ScreenGui") then g.Enabled = false end
        end
    end

    if antiDumb then
        for _, g in ipairs(playerGui:GetChildren()) do
            if g.Name:lower():find("dumb") then g:Destroy() end
        end
    end
end)

