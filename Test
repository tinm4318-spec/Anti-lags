GH.chat = { text = "", input = nil, busy = false, prefix = "🖕 ", limit = 190 }

function GH.chatFormat(text)
    local c = GH.chat
    local out = {}
    local cur = ""
    local function ulen(s) return utf8.len(s) or #s end
    local function push(s)
        if cur == "" then
            cur = s
        elseif ulen(cur .. " " .. s) <= c.limit then
            cur = cur .. " " .. s
        else
            table.insert(out, cur)
            cur = s
        end
    end
    local function add(s)
        s = c.prefix .. s
        while ulen(s) > c.limit do
            local cut = utf8.len(s) and utf8.offset(s, c.limit + 1) or (c.limit + 1)
            push(s:sub(1, cut - 1))
            s = s:sub(cut)
        end
        if s ~= "" then push(s) end
    end
    local found = false
    for sentence in tostring(text):gmatch("[^%.!%?\n]+[%.!%?]*") do
        local s = sentence:match("^%s*(.-)%s*$")
        if s ~= "" then
            found = true
            add(s)
        end
    end
    if not found then
        local s = tostring(text):match("^%s*(.-)%s*$")
        if s ~= "" then add(s) end
    end
    if cur ~= "" then table.insert(out, cur) end
    return out
end

function GH.chatSend()
    local c = GH.chat
    if c.busy then return end
    local list = GH.chatFormat(c.text)
    if #list == 0 then
        WindUI:Notify({ Title = "Chat", Content = "Type a message first.", Duration = 2 })
        return
    end
    c.busy = true
    c.text = ""
    pcall(function() c.input:Set("") end)
    task.spawn(function()
        for i, msg in ipairs(list) do
            if not GH.alive then break end
            say(msg)
            if i < #list then task.wait(1.2) end
        end
        c.busy = false
    end)
end

