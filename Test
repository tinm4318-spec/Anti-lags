local hopCounter = hopTab:Paragraph({ Title = "Servers", Desc = "0 loaded" })

local fetchHop

hopTab:Button({ Title = "Refresh", Callback = function() if fetchHop then fetchHop() end end })
hopTab:Button({
    Title = "Toggle Sort (Desc / Asc)",
    Callback = function()
        hop.asc = not hop.asc
        if fetchHop then fetchHop() end
    end,
})
hopTab:Button({
    Title = "Rejoin Current Server",
    Callback = function()
        pcall(function()
            teleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
        end)
    end,
})

local hopRowCache = {}
local function clearHopRows()
    for _, btn in ipairs(hopRowCache) do
        pcall(function() btn:Destroy() end)
    end
    hopRowCache = {}
end

local function renderHopList()
    clearHopRows()
    if #hop.servers == 0 then
        hopStatus:SetDesc("no servers")
        return
    end
    for idx, srv in ipairs(hop.servers) do
        local playing = tonumber(srv.playing) or 0
        local maxP    = tonumber(srv.maxPlayers) or 0
        local isFull  = playing >= maxP
        local isCurr  = srv.id == game.JobId
        local isPrev  = hop.supportsFiles and tostring(srv.id) == tostring(hop.prevServer)
        local tag = ""
        if isCurr then tag = " (yours)"
        elseif isPrev then tag = " (prev)"
        elseif isFull then tag = " (full)" end
        local btn = hopTab:Button({
            Title = string.format("%d · %s", idx, tostring(srv.id):sub(1, 12)),
            Desc  = string.format("Playing %d/%d%s", playing, maxP, tag),
            Callback = function()
                pcall(function()
                    teleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, localPlayer)
                end)
            end,
        })
        table.insert(hopRowCache, btn)
    end
    hopStatus:SetDesc("ready")
end

function fetchHop()
    if hop.updating then return end
    hop.updating = true
    hopStatus:SetDesc("fetching...")
    task.spawn(function()
        local order = hop.asc and "Asc" or "Desc"
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100")
            :format(game.PlaceId, order)
        local body
        if _req then
            pcall(function()
                local res = _req({ Url = url, Method = "GET" })
                body = res and res.Body
            end)
        end
        if not body then
            pcall(function() body = game:HttpGet(url) end)
        end
        local data
        if body then
            local ok, decoded = pcall(function() return httpService:JSONDecode(body) end)
            if ok and decoded and decoded.data then data = decoded.data end
        end
        if not data then
            hopStatus:SetDesc("rate limited / failed")
            hopCounter:SetDesc("0 loaded")
            hop.updating = false
            return
        end
        hop.servers = {}
        for _, v in ipairs(data) do
            if type(v) == "table" and v.id and v.playing and v.maxPlayers then
                table.insert(hop.servers, v)
            end
        end
        while #hop.servers > hop.maxServers do
            table.remove(hop.servers)
        end
        hopCounter:SetDesc(string.format("%d servers", #hop.servers))
        renderHopList()
        hop.updating = false
    end)
end

