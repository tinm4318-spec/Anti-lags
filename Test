function GH.cubesEnable()
    local c = GH.cubes
    if c.conn then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = coreGui
    c.hl = hl
    c.conn = userInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        local kind = input.UserInputType
        if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
        local cam = workspace.CurrentCamera
        local bricks = workspace:FindFirstChild("Bricks")
        if not cam or not bricks then return end
        local ray = cam:ScreenPointToRay(input.Position.X, input.Position.Y)
        local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000)
        local part = hit and hit.Instance
        if not part or not part.Parent or not part:IsDescendantOf(bricks) then
            hl.Adornee = nil
            return
        end
        local holder = part.Parent
        local text
        local count = 0
        local capped = false
        if holder == bricks then
            text = "Server Build (Not from anyone)"
            for _, ch in ipairs(bricks:GetChildren()) do
                if ch:IsA("BasePart") then count = count + 1 end
            end
            hl.Adornee = part
        else
            local plr = players:FindFirstChild(holder.Name)
            if plr and plr:IsA("Player") then
                text = plr.DisplayName == plr.Name and plr.Name or (plr.DisplayName .. "/" .. plr.Name)
            else
                text = holder.Name .. " (NOT INGAME)"
            end
            for _, d in ipairs(holder:GetChildren()) do
                if d:IsA("BasePart") then count = count + 1 end
            end
            if count <= c.maxHighlight then
                hl.Adornee = holder
            else
                hl.Adornee = part
                capped = true
            end
        end
        WindUI:Notify({
            Title = "Cubes Checker",
            Content = "Block is from: " .. text .. "\nBlocks: " .. count .. (capped and ("\nToo many to highlight all (limit " .. c.maxHighlight .. ")") or ""),
            Duration = 4,
        })
    end)
end

