local function toolEvent(name)
    local char = localPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChild(name) or localPlayer.Backpack:FindFirstChild(name)
    return tool and tool:FindFirstChild("Event", true)
end

local function toolEventAny(name)
    local tool = localPlayer.Backpack:FindFirstChild(name)
        or (localPlayer.Character and localPlayer.Character:FindFirstChild(name))
    if not tool then return nil end
    return tool:FindFirstChild("Event", true)
        or tool:FindFirstChildWhichIsA("RemoteEvent", true)
end

local function equipTool(name)
    local t = localPlayer.Backpack:FindFirstChild(name)
    if t and localPlayer.Character then
        localPlayer.Character.Humanoid:EquipTool(t)
    end
    return localPlayer.Character
        and (localPlayer.Character:FindFirstChild(name) or localPlayer.Backpack:FindFirstChild(name))
end

local function bypassText(src)
    local out = ""
    math.randomseed(tick())
    for i = 1, #src do
        local c = src:sub(i, i)
        if c == " " then
            out = out .. c
        else
            local r1 = math.random(1, #alphabet)
            local r2 = math.random(1, 3)
            local ch = alphabet:sub(r1, r1)
            if r2 == 1 then
                out = out .. string.format("<%s>%s</%s>", ch, c, ch)
            elseif r2 == 2 then
                out = out .. string.format("<%s>%s", ch, c)
            else
                out = out .. c
            end
        end
    end
    return out
end

local function randomAroundSphere(hrp, lo, hi)
    local r  = math.random() * (hi - lo) + lo
    local th = math.random() * math.pi * 2
    local ph = math.acos(2 * math.random() - 1)
    return hrp.Position + Vector3.new(
        r * math.sin(ph) * math.cos(th),
        r * math.cos(ph),
        r * math.sin(ph) * math.sin(th)
    )
end

local function nearestBrickInRange(range)
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local folder = workspace:FindFirstChild("Bricks") or workspace:FindFirstChild("PlacedBlocks")
    if not folder then return nil end
    local pool = {}
    for _, p in ipairs(folder:GetDescendants()) do
        if p:IsA("BasePart") and (hrp.Position - p.Position).Magnitude <= range then
            table.insert(pool, p)
        end
    end
    return #pool > 0 and pool[math.random(1, #pool)] or nil
end

