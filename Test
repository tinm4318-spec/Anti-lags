local function setupClickDetector(handle)
    if boomboxClickDetectors[handle] then return end
    local cd = Instance.new("ClickDetector")
    cd.MaxActivationDistance = 32
    cd.Parent = handle
    local conn = cd.MouseClick:Connect(function()
        if boomboxLoggerEnabled then
            onBoomboxClicked(handle)
        end
    end)
    boomboxClickDetectors[handle] = { detector = cd, connection = conn }
end

local function scanBoomboxes()
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("Tool") and BOOMBOX_NAMES[item.Name] then
            local handle = item:FindFirstChild("Handle")
            if handle and not boomboxClickDetectors[handle] then
                setupClickDetector(handle)
            end
        end
    end
end

local function clearClickDetectors()
    for handle, data in pairs(boomboxClickDetectors) do
        if data.connection then data.connection:Disconnect() end
        if data.detector and data.detector.Parent then data.detector:Destroy() end
