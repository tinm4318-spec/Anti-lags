function GH.makeUI(Library)
    local UI = { Themes = {}, theme = nil, devIds = {}, premIds = {}, IsDev = false, IsPremium = false, footer = nil }
    local counter = 0
    local noop = function() end

    local function nextId(prefix)
        counter = counter + 1
        return prefix .. counter
    end

    local function icon(name)
        if type(name) ~= "string" or name == "" then return nil end
        return (name:gsub("^lucide:", ""))
    end

    local function inList(list, id)
        for _, v in ipairs(list) do
            if tostring(v) == tostring(id) then return true end
        end
        return false
    end

    local function refreshAccess()
        local id = localPlayer.UserId
        UI.IsDev = inList(UI.devIds, id)
        UI.IsPremium = inList(UI.premIds, id)
    end

    local function nullObject()
        return setmetatable({}, { __index = function() return noop end })
    end

    local function decimals(step)
        local n = 0
        local s = tonumber(step) or 1
        while n < 6 and math.abs(s - math.floor(s + 0.5)) > 1e-9 do
            s = s * 10
            n = n + 1
        end
        return n
    end

    local function element(el, text, note)
        local w = {}
        function w:Set(v) if el and el.SetValue then el:SetValue(v) end end
        function w:Select(v) if el and el.SetValue then el:SetValue(v) end end
        function w:Refresh(list) if el and el.SetValues then el:SetValues(list or {}) end end
        function w:SetDesc(d)
            if el and el.SetText then
                el:SetText(text and (text .. ": " .. tostring(d)) or tostring(d))
            end
        end
        function w:Destroy()
            if el and el.Destroy then pcall(function() el:Destroy() end) end
            if note and note.Destroy then pcall(function() note:Destroy() end) end
        end
        return w
    end

    local function makeTab(tab, title)
        local T = { gb = nil, side = 1, n = { 0, 0 } }

        local function section(name)
            local side = T.n[1] <= T.n[2] and 1 or 2
            T.side = side
            T.gb = tab:AddGroupbox({
                Side = side,
                Name = name or title,
                DisableCollapsing = true,
                PopOut = false,
            })
            return T.gb
        end

        local function box()
            local gb = T.gb or section(title)
            T.n[T.side] = T.n[T.side] + 1
            return gb
        end

        local function desc(cfg)
            local d = cfg and cfg.Desc
            if type(d) ~= "string" or d == "" then return nil end
            return box():AddLabel(d, true)
        end

        function T:Section(cfg)
            section(cfg and cfg.Title or title)
        end

        function T:Toggle(cfg)
            cfg = cfg or {}
            local el = box():AddToggle(nextId("t"), {
                Text = cfg.Title or "Toggle",
                Default = cfg.Value == true,
                Callback = function(v)
                    if cfg.Callback then cfg.Callback(v) end
                end,
            })
            return element(el, nil, desc(cfg))
        end
        T.PremToggle = T.Toggle

        function T:Button(cfg)
            cfg = cfg or {}
            local el = box():AddButton({
                Text = cfg.Title or "Button",
                Func = function()
                    if cfg.Callback then cfg.Callback() end
                end,
            })
            return element(el, nil, desc(cfg))
        end

        function T:Slider(cfg)
            cfg = cfg or {}
            local v = type(cfg.Value) == "table" and cfg.Value or {}
            local min = v.Min or 0
            local max = v.Max or 100
            local step = cfg.Step or v.Step or 1
            local el = box():AddSlider(nextId("s"), {
                Text = cfg.Title or "Slider",
                Default = v.Default or min,
                Min = min,
                Max = max,
                Rounding = decimals(step),
                Suffix = v.Suffix or cfg.Suffix or "",
                Callback = function(x)
                    if cfg.Callback then cfg.Callback(x) end
                end,
            })
            return element(el, nil, desc(cfg))
        end

        function T:Dropdown(cfg)
            cfg = cfg or {}
            local el = box():AddDropdown(nextId("d"), {
                Text = cfg.Title or "Dropdown",
                Values = cfg.Values or {},
                Default = type(cfg.Value) == "string" and cfg.Value or nil,
                Multi = false,
                Callback = function(x)
                    if cfg.Callback then cfg.Callback(x) end
                end,
            })
            return element(el, nil, desc(cfg))
        end

        function T:Input(cfg)
            cfg = cfg or {}
            local el = box():AddInput(nextId("i"), {
                Text = cfg.Title or "Input",
                Default = cfg.Default or "",
                Placeholder = cfg.Placeholder or "",
                ClearTextOnFocus = false,
                Callback = function(x)
                    if cfg.Callback then cfg.Callback(x) end
                end,
            })
            return element(el, nil, desc(cfg))
        end

        function T:Paragraph(cfg)
            cfg = cfg or {}
            local name = cfg.Title
            if type(name) == "string" and name:match("^%s*$") then name = nil end
            local desc = cfg.Desc and tostring(cfg.Desc) or ""
            local text = name and (desc ~= "" and (name .. ": " .. desc) or name) or desc
            local el = box():AddLabel(text, true)
            return element(el, name)
        end

        return T
    end

    function UI:SetFont() end
    function UI:AddTheme(t)
        UI.Themes[t.Name] = t
        return t
    end
    function UI:SetTheme(name)
        UI.theme = UI.Themes[name] or UI.theme
    end
    function UI:SetDevIds(ids) UI.devIds = ids or {} refreshAccess() end
    function UI:SetPremiumIds(ids) UI.premIds = ids or {} refreshAccess() end
    function UI:CaptureTransparency()
        if UI.transCaptured then return end
        UI.transCaptured = true
        UI.transItems = {}
        local gui = Library.ScreenGui
        if not gui then return end
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("GuiObject") then
                table.insert(UI.transItems, { obj = d, bg = d.BackgroundTransparency })
            end
        end
    end
    function UI:SetUITransparency(t)
        t = math.clamp(t, 0, 0.9)
        UI:CaptureTransparency()
        for _, item in ipairs(UI.transItems) do
            if item.obj.Parent then
                item.obj.BackgroundTransparency = item.bg + (1 - item.bg) * t
            end
        end
    end
    function UI:Notify(cfg)
        cfg = cfg or {}
        Library:Notify({
            Title = cfg.Title or "GongHub",
            Description = cfg.Content or "",
            Time = cfg.Duration or 4,
        })
    end

    function UI:CreateWindow(cfg)
        cfg = cfg or {}
        refreshAccess()
        local t = UI.theme
        if t then
            local S = Library.Scheme
            if t.Background then S.BackgroundColor = t.Background end
            if t.Accent then S.MainColor = t.Accent end
            local accent = t.Primary or t.Toggle or t.Icon
            if accent then S.AccentColor = accent end
            if t.Outline and t.Background then S.OutlineColor = t.Outline:Lerp(t.Background, 0.75) end
            if t.Text then S.FontColor = t.Text end
        end
        UI.footer = cfg.Author
        local win = Library:CreateWindow({
            Title = cfg.Title or "GongHub",
            Footer = cfg.Author or "",
            Center = true,
            AutoShow = true,
            Size = UDim2.fromOffset(640, 470),
            CornerRadius = cfg.Radius or 0,
            ToggleKeybind = cfg.ToggleKey or Enum.KeyCode.K,
            Font = Enum.Font.Code,
            Resizable = cfg.Resizable == true,
            ShowCustomCursor = false,
            ShowMobileButtons = true,
            MobileButtonsSide = "Left",
        })

        Library.CantDragForced = cfg.Draggable == false

        local hub = {}        local hub = {}
        function hub:Tag(c)
            if c and c.Title and win and win.SetFooter then
                local text = (UI.footer and UI.footer ~= "") and (UI.footer .. " " .. c.Title) or c.Title
                pcall(function() win:SetFooter(text) end)
            end
        end
        function hub:Tab(c)
            c = c or {}
            if c.Locked then return nullObject() end
            local name = c.Title or "Tab"
            local ok, tab = pcall(function() return win:AddTab(name, icon(c.Icon)) end)
            if not ok or not tab then
                ok, tab = pcall(function() return win:AddTab(name) end)
            end
            if not ok or not tab then return nullObject() end
            return makeTab(tab, name)
        end
        function hub:DevTab(c)
            if UI.IsDev then return hub:Tab(c) end
            return nullObject()
        end
        function hub:PremTab(c)
            if UI.IsPremium then return hub:Tab(c) end
            return nullObject()
        end
        function hub:OnDestroy(cb) Library:OnUnload(cb) end
        function hub:Destroy() Library:Unload() end
        return hub
    end

    return UI
end

