local function markPending()
    autoExecutePending = true
    autoExecuteTimestamp = os.time()
    pcall(function()
        if writefile then
            writefile(AUTOEXEC_MARK_FILE, "pending")
            writefile(AUTOEXEC_JOB_FILE, game.JobId)
            writefile(AUTOEXEC_PLACE_FILE, tostring(game.PlaceId))
            writefile(AUTOEXEC_TIME_FILE, tostring(autoExecuteTimestamp))
        end
    end)
    saveAutoExec()
end

local function clearPending()
    autoExecutePending = false
    autoExecuteLastJob = ""
    autoExecutePlace = 0
    autoExecuteTimestamp = 0
    pcall(function()
        if writefile then
            writefile(AUTOEXEC_MARK_FILE, "done")
            writefile(AUTOEXEC_JOB_FILE, "")
            writefile(AUTOEXEC_PLACE_FILE, "0")
            writefile(AUTOEXEC_TIME_FILE, "0")
        end
    end)
end

local function prepareAutoExecute()
    if not autoExecute then return end
    if autoExecuteLoader == "" then return end
    if GH.queued then return end
    if SCRIPT_KEY:sub(1, 2) == "@@" then return end

    local queueFn = (syn and syn.queue_on_teleport)
        or queue_on_teleport
        or queueonteleport
        or (fluxus and fluxus.queue_on_teleport)
        or (krnl and krnl.queue_on_teleport)
        or (http and http.queue_on_teleport)

    if queueFn then
        local ok = pcall(function()
            queueFn(autoExecuteLoader)
        end)
        if ok then
            GH.queued = true
            clearPending()
            return
        end
    end

