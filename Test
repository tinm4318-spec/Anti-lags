local function findBoomboxFromPart(part)
    if not part then return nil end
    local p = part
    for _ = 1, 4 do
        if not p then return nil end
        if BOOMBOX_NAMES[p.Name] and p:IsA("Tool") then return p end
        p = p.Parent
    end
    return nil
end

local function getBoomboxId(handle)
    if not handle then return nil end
    local sound = handle:FindFirstChild("Sound")
    if not sound or not sound:IsA("Sound") then return nil end
    if sound.SoundId == "" then return nil end
    return sound.SoundId:match("%d+")
end

local function flashBoombox(handle)
    if not handle then return end
    local flash = Instance.new("SelectionBox")
    flash.Color3 = Color3.new(0, 0, 0)
    flash.LineThickness = 0.05
    flash.Transparency = 0
    flash.Adornee = handle
    flash.Parent = handle
    task.spawn(function()
        for i = 0, 1, 0.1 do
            flash.Transparency = i
            task.wait(0.05)
        end
        flash:Destroy()
    end)
end

local function onBoomboxClicked(handle)
    local id = getBoomboxId(handle)
    if not id then
        WindUI:Notify({ Title = "Boombox", Content = "No sound playing.", Duration = 2 })
