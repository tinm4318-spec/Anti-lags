local function _fileIO()
    local ok = pcall(function() writefile("_ae.tmp", "x") end)
    if not ok then return nil end
    pcall(function() delfile("_ae.tmp") end)
    return {
        read  = function(n) local ok2, v = pcall(readfile, n); return ok2 and v or nil end,
        write = function(n, v) pcall(writefile, n, v) end,
        exists = function(n) local ok2, v = pcall(isfile, n); return ok2 and v or false end,
    }
end

