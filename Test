GH.spray = { name = nil, on = false, gen = 0, conn = nil, keptMap = {}, map = {}, dropdown = nil, radius = 100, mode = "Normal", ALL = "\0ALL" }

function GH.sprayLabels()
    local names = { "All Players" }
    GH.spray.map = { ["All Players"] = GH.spray.ALL }
    local seen = {}
    for _, p in ipairs(players:GetPlayers()) do
        local label = p.DisplayName .. " (@" .. p.Name .. ")"
        if p == localPlayer then label = "[YOU] " .. p.DisplayName end
        table.insert(names, label)
        GH.spray.map[label] = p.Name
        seen[p.Name] = true
    end
    local bricks = workspace:FindFirstChild("Bricks")
    if bricks then
        for _, folder in ipairs(bricks:GetChildren()) do
            if folder.Name ~= "" and not seen[folder.Name] then
                local label = folder.Name .. " (left)"
                table.insert(names, label)
                GH.spray.map[label] = folder.Name
                seen[folder.Name] = true
            end
        end
    end
    return names
end

function GH.sprayOrigin()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position
end

function GH.sprayNear(d, origin)
    local part = d:IsA("BasePart") and d or d:FindFirstAncestorWhichIsA("BasePart")
    if not part then return true end
    return (part.Position - origin).Magnitude <= GH.spray.radius
end

function GH.sprayNearParts(folder, origin)
    local ok, parts = pcall(function()
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { folder }
        return workspace:GetPartBoundsInRadius(origin, GH.spray.radius, params)
    end)
    if ok and type(parts) == "table" then return parts end
    return nil
end

function GH.spraySweep(gen)
    local s = GH.spray
    local bricks = workspace:FindFirstChild("Bricks")
    if not bricks then return 0 end
    local isAll = s.name == s.ALL
    local removed = 0

    if s.mode == "Radius" then
        local origin = GH.sprayOrigin()
        if not origin then return 0 end
        local folder = isAll and bricks or bricks:FindFirstChild(s.name)
        if not folder then return 0 end
        local parts = GH.sprayNearParts(folder, origin)
        if parts then
            for _, part in ipairs(parts) do
                if part.Name == "Spray" then
                    pcall(function() part:Destroy() end)
                    removed = removed + 1
                else
                    for _, c in ipairs(part:GetChildren()) do
                        if c.Name == "Spray" then
                            pcall(function() c:Destroy() end)
                            removed = removed + 1
                        end
                    end
                end
            end
            return removed
        end
        for _, d in ipairs(folder:GetDescendants()) do
            if d.Name == "Spray" and GH.sprayNear(d, origin) then
                pcall(function() d:Destroy() end)
                removed = removed + 1
            end
        end
        return removed
    end

    local function sweepFolder(folder, key)
        if s.keptMap[key] and not s.keptMap[key]:IsDescendantOf(folder) then s.keptMap[key] = nil end
        local seen = 0
        for _, d in ipairs(folder:GetDescendants()) do
            if d.Name == "Spray" then
                if not s.keptMap[key] then
                    s.keptMap[key] = d
                elseif d ~= s.keptMap[key] then
                    pcall(function() d:Destroy() end)
                    removed = removed + 1
                end
            end
            seen = seen + 1
            if seen % 3000 == 0 then
                task.wait()
                if gen and s.gen ~= gen then return true end
            end
        end
        return false
    end

    if isAll then
        for _, folder in ipairs(bricks:GetChildren()) do
            if sweepFolder(folder, folder) then break end
        end
    else
        local folder = bricks:FindFirstChild(s.name)
        if folder then sweepFolder(folder, s.name) end
    end
    return removed
end

function GH.sprayStop()
    local s = GH.spray
    s.gen = s.gen + 1
    if s.conn then
        s.conn:Disconnect()
        s.conn = nil
    end
end

function GH.sprayStart()
    local s = GH.spray
    GH.sprayStop()
    if not s.on or not s.name then return end
    local bricks = workspace:FindFirstChild("Bricks")
    if not bricks then
        WindUI:Notify({ Title = "Anti Spray Lag", Content = "Bricks folder not found.", Duration = 3 })
        return
    end
    s.keptMap = {}
    local gen = s.gen
    local isAll = s.name == s.ALL
    s.conn = bricks.DescendantAdded:Connect(function(d)
        if d.Name ~= "Spray" then return end
        local top = d
        while top.Parent and top.Parent ~= bricks do top = top.Parent end
        if top.Parent ~= bricks then return end
        if not isAll and top.Name ~= s.name then return end
        if s.mode == "Radius" then
            local origin = GH.sprayOrigin()
            if origin and GH.sprayNear(d, origin) then
                task.defer(function() pcall(function() d:Destroy() end) end)
            end
        else
            local key = isAll and top or s.name
            if not s.keptMap[key] or not s.keptMap[key].Parent then
                s.keptMap[key] = d
            else
                task.defer(function() pcall(function() d:Destroy() end) end)
            end
        end
    end)
    task.spawn(function()
        GH.spraySweep(gen)
        while s.gen == gen and GH.alive do
            task.wait(1)
            if s.gen ~= gen then break end
            if s.mode == "Radius" then
                GH.spraySweep(gen)
            end
        end
    end)
end

