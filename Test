-- ============================================================
-- Anti-Maptide + Anti-NaN (merged)
-- ============================================================
local maptideConn = nil
local maptideLoop = nil

local function isNaN(n) return n ~= n end

local function isSafe(cf)
    local p = cf.Position
    return not (
        isNaN(p.X) or isNaN(p.Y) or isNaN(p.Z)
        or math.abs(p.X) == math.huge
        or math.abs(p.Y) == math.huge
        or math.abs(p.Z) == math.huge
        or math.abs(p.Y) > 500000
    )
end

local function isVoided()
    local spawn = workspace:FindFirstChild("Spawn")
    if not spawn then return false end
    local acm = spawn.AssemblyCenterOfMass
    return acm.X == 0 and acm.Y == -1000000 and acm.Z == 0
end

local function onMaptideCharacter(character)
    if not antiMaptide then return end
    local hrp = character:WaitForChild("HumanoidRootPart", 10)
    if not hrp then return end
    if isVoided() then
        hrp.Anchored = true
        task.wait(0.1)
        hrp.CFrame = CFrame.new(0, 3, 0)
        hrp.Anchored = false
        return
    end
    hrp.Anchored = true
    task.wait(0.05)
    if not isSafe(hrp.CFrame) then
        local recovered = false
        for _, plr in ipairs(players:GetPlayers()) do
            if plr ~= localPlayer and plr.Character
                and plr.Character:FindFirstChild("HumanoidRootPart") then
                local otherHRP = plr.Character.HumanoidRootPart
                if isSafe(otherHRP.CFrame) then
                    hrp.CFrame = otherHRP.CFrame + Vector3.new(0, 5, 0)
                    recovered = true
                    break
                end
            end
        end
        if not recovered then hrp.CFrame = CFrame.new(0, 50, 0) end
    end
    hrp.Anchored = false
end

local function enableAntiMaptide()
    antiMaptide = true
    if maptideConn then maptideConn:Disconnect() end
    maptideConn = localPlayer.CharacterAdded:Connect(onMaptideCharacter)
    if localPlayer.Character then onMaptideCharacter(localPlayer.Character) end
    if maptideLoop then maptideLoop:Disconnect() end
    maptideLoop = runService.Heartbeat:Connect(function()
        if not antiMaptide then return end
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and not isSafe(hrp.CFrame) then hrp.CFrame = CFrame.new(0, 50, 0) end
    end)
end

local function disableAntiMaptide()
    antiMaptide = false
    if maptideConn then maptideConn:Disconnect() maptideConn = nil end
    if maptideLoop then maptideLoop:Disconnect() maptideLoop = nil end
end

