-- chat spy
--========================================================

local ChatLog = {}
local MAX_LOG = 300
local ChatListeners = {}
local ChatFilter = {
    say = true, whisper = true, system = true, admin = true, remote = true,
}

local function classifyRemoteName(n)
    n = (n or ""):lower()
    if n:find("whisper") then return "whisper" end
    if n:find("admin") then return "admin" end
    if n:find("system") then return "system" end
    return "remote"
end

local function addChatEntry(src, name, text, kind)
    table.insert(ChatLog, {
        src = src or "?", name = name or "?", text = text or "",
        kind = kind or "say", t = os.date("%H:%M:%S"),
    })
    while #ChatLog > MAX_LOG do table.remove(ChatLog, 1) end
    for _, fn in ipairs(ChatListeners) do pcall(fn, ChatLog[#ChatLog]) end
end

local chatHooksActive = false
local chatConns = {}

local function startChatSpy()
    if chatHooksActive then return end
    chatHooksActive = true

    -- 1. TextChatService (modern)
    if TextChatService then
        if TextChatService.MessageReceived then
            table.insert(chatConns, TextChatService.MessageReceived:Connect(function(msg)
                if not msg then return end
                local src = msg.TextSource
                local name = src and src.Name or "?"
                local text = msg.Text or ""
                addChatEntry("tc", name, text, "say")
            end))
        end
    end

    -- 2. legacy DefaultChatSystemChatEvents
    local dcs = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if dcs then
        local onMsg = dcs:FindFirstChild("OnMessageDoneFiltering")
        if onMsg and onMsg:IsA("RemoteEvent") then
            table.insert(chatConns, onMsg.OnClientEvent:Connect(function(data)
                if type(data) ~= "table" then return end
                local name = data.FromSpeaker or data.Speaker or "?"
                local text = data.Message or data.Text or ""
                if text == "" then return end
                addChatEntry("legacy", name, text, "say")
            end))
        end
    end

    -- 3. hook any string-passing remote in ReplicatedStorage — catches custom chat/whisper
    local function hookRemote(obj)
        if not (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent")) then return end
        local kind = classifyRemoteName(obj.Name)
        local ok, conn = pcall(function()
            return obj.OnClientEvent:Connect(function(...)
                local args = {...}
                for _, a in ipairs(args) do
                    if type(a) == "string" and #a >= 2 and #a <= 500 then
                        addChatEntry("rs", obj.Name, a, kind)
                    elseif type(a) == "table" then
                        for _, v in pairs(a) do
                            if type(v) == "string" and #v >= 2 and #v <= 500 then
                                addChatEntry("rs", obj.Name, v, kind)
                            end
                        end
                    end
                end
            end)
        end)
        if ok and conn then table.insert(chatConns, conn) end
    end
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do hookRemote(obj) end
    table.insert(chatConns, ReplicatedStorage.DescendantAdded:Connect(hookRemote))
end

local function stopChatSpy()
    chatHooksActive = false
    for _, c in ipairs(chatConns) do pcall(function() c:Disconnect() end) end
    chatConns = {}
end

