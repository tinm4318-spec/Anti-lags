--========================================================
-- protection registry
--========================================================

local Protections = {}
local function addProtection(key, label, desc, start, stop)
    Protections[key] = { label=label, desc=desc, start=start, stop=stop, active=false, conns={} }
end
local function toggleProtection(key, on)
    local p = Protections[key]; if not p then return end
    if on and not p.active then
        p.active = true
        local ok = pcall(p.start)
        if not ok then p.active = false end
    elseif not on and p.active then
        p.active = false
        pcall(p.stop)
        for _, c in ipairs(p.conns) do pcall(function() c:Disconnect() end) end
        p.conns = {}
    end
end

